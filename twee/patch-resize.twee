<<if _dolShopPageExperimentMode>>
	<<run $(window).off('resize.DoLShopPageExperiment').on('resize.DoLShopPageExperiment', () => {
"use strict";
(() => {
  // src/early/shop-resize.ts
  var pagination = $("#shop-pagination");
  var pages = $(pagination).find(".shop-pages");
  var buttons = $(pagination).find(".btn-pagination");
  var width = pagination.width();
  var buttonWidth = buttons.outerWidth();
  var isEnoughSpace = ((width ?? NaN) - (buttonWidth ?? NaN) * 2 - 32) / pages.children().length >= 22;
  pages.toggleClass("hidden", !isEnoughSpace);
  pagination.find(".shop-pages-number").toggleClass("hidden", isEnoughSpace);
})();
	})>>
<<else>>
	<<run $(window).off('resize.DoLShopPageExperiment')>>
	<<run $(window).on('resize', () => {
"use strict";
(() => {
  // src/early/shop-resize.ts
  var pagination = $("#shop-pagination");
  var pages = $(pagination).find(".shop-pages");
  var buttons = $(pagination).find(".btn-pagination");
  var width = pagination.width();
  var buttonWidth = buttons.outerWidth();
  var isEnoughSpace = ((width ?? NaN) - (buttonWidth ?? NaN) * 2 - 32) / pages.children().length >= 22;
  pages.toggleClass("hidden", !isEnoughSpace);
  pagination.find(".shop-pages-number").toggleClass("hidden", isEnoughSpace);
})();
	})>>
<</if>>
