{
  "name": "dol-game-ui",
  "version": "3.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "framework:check": "vue-tsc --noEmit -p tsconfig.framework.json",
    "framework:build": "npm run framework:check && node scripts/build-framework.mjs && python scripts/package-framework.py",
    "framework:test": "node tests/framework.cjs",
    "framework:factory:test": "node tests/framework-factory.cjs",
    "framework:author-kit:test": "node tests/framework-author-kit.cjs",
    "framework:workspace:test": "node tests/framework-workspace.cjs",
    "framework:commands:test": "node tests/framework-commands.cjs",
    "framework:motion:test": "node tests/framework-motion.cjs",
    "framework:connect:test": "node tests/framework-connect.cjs",
    "framework:reference:test": "node tests/framework-reference.cjs",
    "framework:vue:build": "npm run framework:build && node scripts/build-framework-vue-comparison.mjs && python scripts/package-framework-vue-comparison.py",
    "framework:vue:test": "node tests/framework-vue-comparison.cjs",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.adapters.json && tsc -p tsconfig.early.json",
    "build": "node scripts/render-state-fields.cjs --check && npm run typecheck && vite build && node scripts/build-early.cjs",
    "pretest": "npm run build",
    "package": "npm run build && python scripts/package.py",
    "test": "node scripts/test-unit.cjs",
    "test:quick": "node scripts/test-workflow.cjs quick",
    "test:release": "node scripts/test-workflow.cjs release",
    "test:perf": "node scripts/test-workflow.cjs performance",
    "types": "tsc -p tsconfig.public.json",
    "lab": "vite --config vite.lab.config.ts",
    "lab:build": "vite build --config vite.lab.config.ts",
    "lab:check": "vue-tsc --noEmit -p tsconfig.lab.json",
    "lab:index": "node component-lab/source-index.cjs",
    "lab:test": "node tests/stone-free-lab.cjs",
    "ci:check": "node scripts/render-state-fields.cjs --check && npm run typecheck && npm run framework:check",
    "ci:unit": "node scripts/test-ci.cjs unit",
    "ci:browser": "node scripts/test-ci.cjs browser",
    "ci:build": "node scripts/build-framework.mjs && python scripts/check-ci-packages.py build",
    "ci:packages": "python scripts/check-ci-packages.py"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1"
  },
  "description": "Responsive interface mod for Degrees of Lewdity",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/102326/DoL-Game-UI.git"
  }
}
