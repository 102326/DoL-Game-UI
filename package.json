{
  "name": "dol-game-ui",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.adapters.json && tsc -p tsconfig.early.json",
    "build": "node scripts/render-state-fields.cjs --check && npm run typecheck && vite build && node scripts/build-early.cjs",
    "pretest": "npm run build",
    "package": "npm run build && node scripts/package.cjs",
    "test": "node scripts/test-unit.cjs",
    "test:quick": "node scripts/test-workflow.cjs quick",
    "test:release": "node scripts/test-workflow.cjs release",
    "test:perf": "node scripts/test-workflow.cjs performance",
    "types": "tsc -p tsconfig.public.json",
    "lab": "vite --config vite.lab.config.ts",
    "lab:build": "vite build --config vite.lab.config.ts",
    "lab:index": "node component-lab/source-index.cjs",
    "lab:test": "node tests/component-lab.cjs",
    "lab:check": "vue-tsc --noEmit -p tsconfig.lab.json"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1"
  },
  "description": "Responsive interface mod for Degrees of Lewdity",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/102326/DoL-Game-UI.git"
  }
}
