{
  "name": "dol-game-ui",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "build": "node scripts/render-state-fields.cjs --check && npm run typecheck && vite build",
