import fs = require('node:fs');
import path = require('node:path');
import cp = require('node:child_process');
import crypto = require('node:crypto');
import assert = require('node:assert/strict');
import playwright = require('playwright');
import browserOptions = require('../tests/browser-options.cjs');
const {chromium}=playwright;
declare const hubPreview:{counts():{settings:number;native:number}};
(async()=>{
 const media=path.resolve('docs/media/evolution-hub-h01'),out=path.resolve('tests/artifacts/evolution/hub-h01-record-'+Date.now());fs.mkdirSync(media,{recursive:true});fs.mkdirSync(out,{recursive:true});
 const files=['framework/official-ui/hub.ts','framework/motion-hub/MotionHub.vue','framework/motion-hub/geometry.ts','src/ui/visual-scope.ts','scripts/preview-evolution-hub.mjs','scripts/record-evolution-hub.cts','scripts/record-evolution-hub.cjs','package-lock.json','dist/framework/official-ui/style.css',...cp.execFileSync('git',['ls-files','--cached','--others','--exclude-standard','src/ui/golden-spin','src/ui/weather'],{encoding:'utf8'}).trim().split('\n').filter(Boolean)];const hash=(b:string|Buffer)=>crypto.createHash('sha256').update(b).digest('hex'),sources=()=>Object.fromEntries(files.map(f=>[f,hash(fs.readFileSync(f))])),before=sources(),records:unknown[]=[];
 const {createHubPreviewServer}=await import('./preview-evolution-hub.mjs'),server=await createHubPreviewServer(0),browser=await chromium.launch(browserOptions);
 const address=server.httpServer?.address();assert.ok(address&&typeof address!=='string');
