  const context=await browser.newContext({viewport,deviceScaleFactor:1,recordVideo:{dir:path.join(out,name),size:viewport}}),p=await context.newPage(),errors:string[]=[],events:{label:string;actualMs:number}[]=[];p.on('pageerror',e=>errors.push(e.message));await p.goto('http://127.0.0.1:'+address.port+'/');await p.waitForSelector('.spin-hub-canvas');const start=Date.now(),ball=p.locator('.sf-motion-ball');const event=async(label:string,fn:()=>Promise<unknown>)=>{await fn();events.push({label,actualMs:Date.now()-start})};
  await p.waitForTimeout(500);await event('H1 实际工具并行展开',()=>ball.click());await p.waitForFunction(()=>document.querySelector<HTMLElement>('.sf-motion-hub')?.dataset.spinPhase==='open');await p.waitForTimeout(700);await p.screenshot({path:path.join(media,name+'.png')});
  await event('H2 Escape收束',()=>ball.press('Escape'));await p.waitForFunction(()=>document.querySelector<HTMLElement>('.sf-motion-hub')?.dataset.spinPhase==='closed');await p.waitForTimeout(900);
  await event('H3 中途反向',async()=>{await ball.click();await p.waitForTimeout(90);await ball.press('Escape');await p.waitForTimeout(130);await ball.click()});await p.waitForFunction(()=>document.querySelector<HTMLElement>('.sf-motion-hub')?.dataset.spinPhase==='open');
