  await event('H4 原生社交入口一次',async()=>{await ball.click();await p.waitForFunction(()=>document.querySelector<HTMLElement>('.sf-motion-hub')?.dataset.spinPhase==='open');await p.locator('[data-motion-view$="native-social"]').click()});await p.waitForTimeout(1000);
  await event('左侧移动与停靠',async()=>{await ball.focus();await ball.press('ArrowLeft');await ball.click();await p.waitForFunction(()=>document.querySelector<HTMLElement>('.sf-motion-hub')?.dataset.spinPhase==='open');await p.getByRole('button',{name:'停靠侧边',exact:true}).click()});await p.waitForTimeout(1100);await event('恢复球体与展开',async()=>{await ball.click();await ball.click()});await p.waitForTimeout(1300);
  const final=await p.evaluate(()=>{const ball=document.querySelector('.sf-motion-ball');if(!ball)throw Error('Missing actual Hub ball');return {counts:hubPreview.counts(),open:ball.getAttribute('aria-expanded'),canvases:document.querySelectorAll('.spin-hub-canvas').length,gameData:false}});assert.deepEqual(errors,[]);assert.equal(final.counts.settings,1);assert.equal(final.counts.native,1);assert.equal(final.canvases,1);
  const video=p.video();assert.ok(video);await context.close();cp.execFileSync('ffmpeg',['-y','-i',await video.path(),'-c:v','libx264','-crf','23','-pix_fmt','yuv420p','-movflags','+faststart',path.join(media,name+'-1x.mp4')],{stdio:'pipe'});records.push({name,viewport:{...viewport,dpr:1},events,final,errors});
 }
 assert.deepEqual(sources(),before,'recording sources changed');const scope='Actual official Hub and settings/weather owners with first-party native-entry stand-ins. Original speed, all waits retained. Inspector is a mock notification. Not full game, physical touch, frozen old/new comparison or owner G2 approval.';
