import fs = require('node:fs');
import path = require('node:path');
import cp = require('node:child_process');
import crypto = require('node:crypto');
import assert = require('node:assert/strict');
import playwright = require('playwright');
import browserOptions = require('../tests/browser-options.cjs');
const {chromium}=playwright;
declare const previewWeather:{set(kind:string):void};
(async()=>{
 const frost=process.argv.includes('--frost'),snow=frost||process.argv.includes('--snow'),weather=snow||process.argv.includes('--weather');
 const out=path.resolve('tests/artifacts/evolution/'+(frost?'frost-s02-approved-record-':snow?'snow-s01-record-':weather?'weather-w01-record-':'settings-s01-record-')+Date.now()),media=path.resolve(frost?'docs/media/evolution-frost-s02-approved':snow?'docs/media/evolution-snow-s01':weather?'docs/media/evolution-weather-w01':'docs/media/evolution-settings-s01');fs.mkdirSync(out,{recursive:true});fs.mkdirSync(media,{recursive:true});
 const files=['src/theme/controller.ts','src/theme/SettingsPanel.vue','src/theme/SettingsNavigation.vue','src/theme/settings-workspace.css','src/theme/dark-acrylic.css','src/theme/preferences.ts','src/ui/SettingsToggle.vue','src/ui/GameButton.vue','src/ui/source-motion.ts','src/ui/visual-scope.ts','scripts/preview-evolution-settings.mjs','scripts/record-evolution-settings.cjs','package-lock.json','dist/framework/official-ui/style.css'];
 if(weather)files.push('framework/official-ui/weather.ts','framework/official-ui/navigation.ts',...cp.execFileSync('git',['ls-files','--cached','--others','--exclude-standard','src/ui/weather'],{encoding:'utf8'}).trim().split('\n').filter(Boolean));
 const hash=(b:string|Buffer)=>crypto.createHash('sha256').update(b).digest('hex'),sources=()=>Object.fromEntries(files.map(f=>[f,hash(fs.readFileSync(f))])),before=sources();
 const {createSettingsPreviewServer}=await import('./preview-evolution-settings.mjs'),server=await createSettingsPreviewServer(0),browser=await chromium.launch(browserOptions),records:unknown[]=[];
 const address=server.httpServer?.address();assert.ok(address&&typeof address!=='string');
 try{for(const [name,viewport]of [['desktop',{width:1280,height:900}],['narrow',{width:390,height:844}]] as const){
  const context=await browser.newContext({viewport,deviceScaleFactor:1,recordVideo:{dir:path.join(out,name),size:viewport}}),page=await context.newPage(),errors:string[]=[],events:{label:string;actualMs:number}[]=[];page.on('pageerror',e=>errors.push(e.message));await page.goto('http://127.0.0.1:'+address.port+(weather?'/?weather=clear':''));await page.waitForSelector('#dol-midnight-sidebar-button');const start=Date.now();
  const event=async(label:string,fn:()=>Promise<unknown>)=>{await fn();events.push({label,actualMs:Date.now()-start})};
  await page.waitForTimeout(700);await event('打开真实界面设置',()=>page.getByRole('button',{name:'界面设置',exact:true}).click());await page.waitForTimeout(700);if(snow){await event('Weather: feather snow',()=>page.evaluate(()=>previewWeather.set('snow')));await page.waitForTimeout(3500)}else if(weather){for(const level of ['light','normal','heavy','severe']){await event('Weather: '+level,()=>page.evaluate(level=>previewWeather.set(level),level));await page.waitForTimeout(3500)}}await page.screenshot({path:path.join(media,name+'.png')});
  await event('修改舒适阅读',()=>page.getByLabel('舒适阅读间距',{exact:true}).click());await page.waitForTimeout(600);
  for(const label of ['材质','入口','页面','阅读']){await event('分类：'+label,()=>page.getByRole('button',{name:label,exact:true}).click());await page.waitForTimeout(720)}
  if(weather){await event('Weather: snow',()=>page.evaluate(()=>previewWeather.set('snow')));await page.waitForTimeout(3500);await event('Weather: midway reversal',async()=>{await page.evaluate(()=>previewWeather.set('heavy'));await page.waitForTimeout(650);await page.evaluate(()=>previewWeather.set('snow'));await page.waitForTimeout(450);await page.evaluate(()=>previewWeather.set('severe'))});await page.waitForTimeout(3500)}
  await event('关闭真实设置',()=>page.locator('.dmt-close').click());await page.waitForFunction(()=>document.querySelector<HTMLDialogElement>('dialog')?.open===false);await page.waitForTimeout(700);
  await event('恢复正文操作',()=>page.getByRole('button',{name:'正文操作',exact:true}).click());await page.waitForTimeout(650);
  await event('再次打开',()=>page.getByRole('button',{name:'界面设置',exact:true}).click());await event('快速切换分类',async()=>{for(const label of ['材质','入口','阅读']){await page.getByRole('button',{name:label,exact:true}).click();await page.waitForTimeout(80)}});await page.waitForFunction(()=>!document.querySelector('[data-workspace-transition]'));await page.waitForTimeout(650);await event('Escape关闭',()=>page.keyboard.press('Escape'));await page.waitForFunction(()=>document.querySelector<HTMLDialogElement>('dialog')?.open===false);await page.waitForTimeout(700);
  const final=await page.evaluate(()=>{const dialog=document.querySelector('dialog'),native=document.getElementById('native-status');if(!(dialog instanceof HTMLDialogElement)||!native)throw Error('Missing actual settings or native status');return {open:dialog.open,sections:document.querySelectorAll('.dmt-workspace-section').length,transition:!!document.querySelector('[data-workspace-transition]'),native:native.textContent,proxies:document.querySelectorAll('.dmt-settings-context,.dmt-settings-material,.dmt-open-material').length}});assert.deepEqual(errors,[]);assert.equal(final.open,false);assert.equal(final.sections,1);assert.equal(final.transition,false);assert.equal(final.proxies,0);
  const video=page.video();assert.ok(video);await context.close();cp.execFileSync('ffmpeg',['-y','-i',await video.path(),'-c:v','libx264','-crf','23','-pix_fmt','yuv420p','-movflags','+faststart',path.join(media,name+'-1x.mp4')],{stdio:'pipe'});records.push({name,viewport:{...viewport,dpr:1},events,final,errors});
 }
 assert.deepEqual(sources(),before,'recording inputs changed');const scope='Current actual settings source and production CSS; first-party mock page, no game/save data. Both videos retain original speed and all waiting; not a frozen old/new visual comparison or real-device acceptance.';
 fs.writeFileSync(path.join(media,'result.json'),JSON.stringify({scope,snow,frost,inputHead:cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),workingTree:true,sources:before,runtime:{platform:process.platform,node:process.version,chromium:browser.version()},records},null,2));
 const names=['desktop.png','narrow.png','desktop-1x.mp4','narrow-1x.mp4','result.json'],members=Object.fromEntries(names.map(f=>[f,{bytes:fs.statSync(path.join(media,f)).size,sha256:hash(fs.readFileSync(path.join(media,f)))}]));assert.ok(Object.values(members).reduce((n,m)=>n+m.bytes,0)<=12*1024*1024,'controlled media exceeds12MiB, do not truncate');fs.writeFileSync(path.join(media,'manifest.json'),JSON.stringify({scope,files:members},null,2));if(snow)assert.ok(fs.readdirSync(media).reduce((n,f)=>n+fs.statSync(path.join(media,f)).size,0)<=12*1024*1024,'snow review with manifest exceeds12MiB');console.log(JSON.stringify({media,records:records.length,bytes:Object.values(members).reduce((n,m)=>n+m.bytes,0)},null,2));
 }finally{await browser.close();await server.close()}
})().catch(e=>{console.error(e);process.exitCode=1});
