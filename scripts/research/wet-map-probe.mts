 assert.deepEqual(result.proof.baseline!.urls,result.proof.candidate!.urls);assert.equal(result.proof.baseline!.pixels,result.proof.candidate!.pixels);assert.deepEqual(result.proof.baseline!.rain,result.proof.candidate!.rain);assert.equal(hash(fs.readFileSync(path.join(out,'baseline.png'))),hash(fs.readFileSync(path.join(out,'candidate.png'))));assert.deepEqual(result.errors,[]);
 const graphFiles=new Set<string>();for(const {server} of servers)for(const mod of server.moduleGraph.urlToModuleMap.values())if(mod.file?.startsWith(root+'/')&&!mod.file.includes('/node_modules/'))graphFiles.add(path.relative(root,mod.file));for(const f of graphFiles)assert.ok(graphBefore[f],`Vite graph input missed at load: ${f}`);result.graphInputs=Object.fromEntries([...graphFiles].sort().map(f=>[f,graphBefore[f]!]));for(const [f,digest] of Object.entries(graphBefore))assert.equal(hash(fs.readFileSync(f)),digest,`Vite input changed: ${f}`);const after=Object.fromEntries(inputs.map(f=>[f,hash(fs.readFileSync(f))]));assert.deepEqual(after,before);result.status='PASS';
