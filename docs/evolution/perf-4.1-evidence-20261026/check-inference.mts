import {readFileSync} from 'node:fs';import {dirname,join,resolve} from 'node:path';import {fileURLToPath,pathToFileURL} from 'node:url';import {createHash} from 'node:crypto';import vm from 'node:vm';import assert from 'node:assert/strict';import {performance} from 'node:perf_hooks';
const [major,minor,patch]=process.versions.node.split('.').map(Number);assert(major===26&&(minor>12||minor===12&&patch>=1),'Use Node >=26.12.1 <27');const dir=dirname(fileURLToPath(import.meta.url));
const source=JSON.parse(readFileSync(join(dir,'inference-source.json'),'utf8')) as {code:string;functionSha256:string;modVersion:string};
assert.equal(createHash('sha256').update(source.code).digest('hex'),source.functionSha256,'Original source snapshot changed');
type Mod={description?:unknown;bootNames?:unknown};type Identity={name:string;bootNames:string[];aliases?:string[]};
type Infer=(mod:unknown,catalog:unknown)=>unknown;
const original=vm.runInNewContext(source.code+';inferRequiredDependencies',{}) as Infer;
let infer:Infer=original;
if(process.argv[2]){const module=await import(pathToFileURL(resolve(process.argv[2])).href) as {inferRequiredDependencies?:unknown};const fn=module.inferRequiredDependencies;assert.equal(typeof fn,'function','Candidate must export inferRequiredDependencies');infer=(m,c)=>(fn as Infer)(m,c)}
const copy=(x:unknown)=>JSON.parse(JSON.stringify(x)) as unknown;
const serial=(x:unknown)=>JSON.stringify(x);
const cases=JSON.parse(readFileSync(join(dir,'inference-cases.json'),'utf8')) as Array<{name:string;mod:unknown;catalog:unknown;expected:unknown}>;assert.equal(cases.length,26);
for(const test of cases){const m=copy(test.mod),c=copy(test.catalog),before=serial([m,c]);const result=infer(m,c);assert.equal(serial(result),serial(test.expected),test.name);assert.equal(serial([m,c]),before,test.name+' mutated input')}
const sequence=JSON.parse(readFileSync(join(dir,'inference-sequence.json'),'utf8')) as {mod:Mod;catalog:Identity[];steps:Array<{patch:{description:string;bootNames?:string[];catalogPatch?:{index:number;aliases:string[]}};expected:unknown}>};assert.equal(sequence.steps.length,6);
for(let i=0;i<sequence.steps.length;i++){const {patch,expected}=sequence.steps[i];sequence.mod.description=patch.description;if(patch.bootNames)sequence.mod.bootNames=patch.bootNames;if(patch.catalogPatch)sequence.catalog[patch.catalogPatch.index].aliases=patch.catalogPatch.aliases;const before=serial([sequence.mod,sequence.catalog]);assert.equal(serial(infer(sequence.mod,sequence.catalog)),serial(expected),'same-object invalidation step '+i);assert.equal(serial([sequence.mod,sequence.catalog]),before,'sequence mutated input');const result=infer(sequence.mod,sequence.catalog);if(Array.isArray(result)&&result.length){const first=result[0];if(first&&typeof first==='object')Object.assign(first,{version:'consumer-mutated'});assert.equal(serial(infer(sequence.mod,sequence.catalog)),serial(expected),'consumer must not corrupt a cached result')}}
const benchmark=[];
for(const size of [25,100,250]){const catalog:Identity[]=Array.from({length:size},(_,i)=>({name:'合成工具'+i,bootNames:['SyntheticTool'+i],aliases:['Synthetic Tool '+i,'测试别名'+i]}));catalog[0]={name:'工具甲',bootNames:['AlphaTools'],aliases:['Alpha Tools']};catalog[1]={name:'工具乙',bootNames:['BetaTools'],aliases:['Beta Tools']};const mod={description:'工具甲是前置。工具乙是前置'};let constructors=0;const counting=new Proxy(RegExp,{construct(t,args,newTarget){constructors++;return Reflect.construct(t,args,newTarget)}});const counted=vm.runInNewContext(source.code+';inferRequiredDependencies',{RegExp:counting}) as Infer;assert.equal(serial(counted(mod,catalog)),serial(original(mod,catalog)));constructors=0;for(let i=0;i<10;i++)counted(mod,catalog);const start=performance.now();for(let i=0;i<10;i++)original(mod,catalog);benchmark.push({syntheticCatalogSize:size,calls:10,regexpConstructorCalls:constructors,originalNodeElapsedMs:performance.now()-start})}
console.log(JSON.stringify({status:'PASS',platform:process.platform,node:process.versions.node,modHubSource:source.modVersion,functionSha256:source.functionSha256,staticCases:cases.length,sameObjectMutationSteps:sequence.steps.length,inputMutation:false,consumerResultIsolation:true,candidate:process.argv[2]??null,benchmark,limits:'Synthetic original-function replay, not full ModHub dependency semantics, browser or device performance. RegExp constructions are not guaranteed engine compilation counts.'},null,2));
