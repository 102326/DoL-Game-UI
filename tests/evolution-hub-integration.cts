async function actualMenuLayout(p:playwright.Page,out:string){
 // Measure the rendered controls, including theme CSS and the sphere adapter.
 // Formula-only checks miss extra footer space, intrinsic grid height and inherited surfaces.
 const boxes=[];await p.emulateMedia({reducedMotion:'reduce'});
 for(const mode of ['fan','grid'] as const)for(const side of ['left','right'] as const){
  await p.evaluate(({mode,side})=>{hubPreview.stop();localStorage.setItem('StoneFreeMotionHub.position.v1',JSON.stringify({side,y:.5,docked:false}));hubPreview.floating.setPreference('mode',mode);hubPreview.remount()},{mode,side});
  for(const [width,height]of [[1280,900],[390,844],[844,390],[280,260]] as const)for(const edge of ['center','top','bottom'] as const){
   await p.setViewportSize({width,height});
   await p.evaluate(({side,edge})=>{hubPreview.stop();localStorage.setItem('StoneFreeMotionHub.position.v1',JSON.stringify({side,y:edge==='top'?0:edge==='bottom'?1:.5,docked:false}));hubPreview.remount()},{side,edge});
   await p.waitForFunction(()=>!testHubVisual.inspect().dead&&testHubVisual.inspect().phase==='closed');
   await p.evaluate(()=>new Promise<void>(resolve=>requestAnimationFrame(()=>requestAnimationFrame(()=>resolve()))));
   const ball=p.locator('.sf-motion-ball'),nav=p.locator('.sf-motion-orbit');
   await ball.click();await p.waitForFunction(()=>testHubVisual.inspect().phase==='open').catch(error=>{throw new Error('Hub did not open for '+JSON.stringify({mode,side,width,height,edge}),{cause:error})});
   const data=await nav.evaluate(n=>{
    const rect=(node:Element)=>{const r=node.getBoundingClientRect();return{x:r.x,y:r.y,width:r.width,height:r.height,right:r.right,bottom:r.bottom}};
    const ball=document.querySelector('.sf-motion-ball');if(!ball)throw Error('Missing layout sphere');
    const controls=[...n.querySelectorAll('button')],petals=[...n.querySelectorAll('.sf-motion-petal')],utilities=[...n.querySelectorAll('.sf-motion-utilities button')];
    return{nav:rect(n),ball:rect(ball),grid:n.classList.contains('is-grid'),petals:petals.map(rect),utilities:utilities.map(rect),controls:controls.map(node=>({...rect(node),hit:node.contains(document.elementFromPoint(node.getBoundingClientRect().x+node.getBoundingClientRect().width/2,node.getBoundingClientRect().y+node.getBoundingClientRect().height/2))})),shell:getComputedStyle(n,'::before').content,shadow:getComputedStyle(n).boxShadow};
   });
   const identity={mode,side,width,height,edge};boxes.push({...identity,...data});
   assert.equal(data.petals.length,5,'all original tools remain present');assert.equal(data.utilities.length,3,'all utility actions remain present');
   assert.ok(data.nav.x>=11.5&&data.nav.y>=11.5&&data.nav.right<=width-11.5&&data.nav.bottom<=height-11.5,'menu stays in the viewport: '+JSON.stringify({...identity,data}));
   const targetCenter=data.ball.y+data.ball.height/2,horizontalOverlap=data.nav.x<data.ball.right+12&&data.nav.right>data.ball.x-12;
   const expectedTop=data.grid&&horizontalOverlap?(data.ball.y-24>=height-data.ball.bottom-24?data.ball.y-12-data.nav.height:data.ball.bottom+12):Math.max(12,Math.min(height-data.nav.height-12,targetCenter-data.nav.height/2));
   assert.ok(Math.abs(data.nav.y-expectedTop)<=1,'menu centers on the sphere unless the viewport requires a shift: '+JSON.stringify({...identity,expectedTop,data}));
   assert.ok(data.nav.right<=data.ball.x||data.nav.x>=data.ball.right||data.nav.bottom<=data.ball.y||data.nav.y>=data.ball.bottom,'sphere remains accessible: '+JSON.stringify({...identity,data}));
   if(!data.grid){
    assert.equal(data.shell,'none','fan has no common backing surface');assert.equal(data.shadow,'none');
    const top=Math.min(...data.petals.map(r=>r.y)),bottom=Math.max(...data.petals.map(r=>r.bottom));
    assert.ok(Math.abs((top+bottom)/2-(data.nav.y+data.nav.height/2))<=1,'visible outer tools center within their real footprint');
    assert.ok(new Set(data.petals.map(r=>Math.round(r.x))).size>1,'outer tools form an arc');
    assert.ok(new Set(data.utilities.map(r=>Math.round(r.y))).size===3,'inner actions replace the bottom row');
    const direction=data.nav.x>=data.ball.right?1:-1,centers=data.utilities.map(r=>r.x+r.width/2);
    assert.ok(Math.abs(centers[0]!-centers[2]!)<=1,'inner arc has symmetric endpoints');
    const bend=(centers[1]!-(centers[0]!+centers[2]!)/2)*direction;
    assert.ok(bend>=7.5&&bend<=8.5,'middle inner action curves outward from the sphere: '+JSON.stringify({...identity,bend,centers}));
    for(const utility of data.utilities)assert.ok(Math.abs(utility.width-64)<=.5&&Math.abs(utility.height-44)<=.5,'inner arc retains its 64×44 hit boxes');
    if(side==='right'){
     const mirror:{utilities:typeof data.utilities;ball:typeof data.ball}=must(boxes.find(r=>r.mode==='fan'&&r.side==='left'&&r.width===width&&r.height===height&&r.edge===edge));
     for(const [index,utility]of data.utilities.entries()){const opposite=mirror.utilities[index]!;assert.ok(Math.abs((data.ball.x+data.ball.width/2-utility.x-utility.width/2)-(opposite.x+opposite.width/2-mirror.ball.x-mirror.ball.width/2))<=1&&Math.abs((utility.y-data.ball.y)-(opposite.y-mirror.ball.y))<=1,'inner arc mirrors between the two sides')}
    }
    for(const utility of data.utilities){assert.ok(utility.width<data.petals[0]!.width&&utility.height<data.petals[0]!.height,'inner actions are smaller');for(const tool of data.petals)assert.ok(utility.right<=tool.x||utility.x>=tool.right||utility.bottom<=tool.y||utility.y>=tool.bottom,'inner actions do not intersect outer tools')}
    assert.ok(data.controls.every(r=>r.hit),'every fan control can receive input');
   }else{
    assert.equal(data.shell,'""','grid retains its panel backing');
    for(const button of await nav.locator('button').all()){await button.evaluate(n=>n.scrollIntoView({block:'nearest'}));assert.ok(await button.evaluate(n=>{const r=n.getBoundingClientRect();return r.y>=12&&r.bottom<=innerHeight-12&&n.contains(document.elementFromPoint(r.x+r.width/2,r.y+r.height/2))}),'grid controls remain reachable by scrolling')}
   }
   if(edge==='center'&&(width===1280||width===390))await p.screenshot({path:path.join(out,`layout-${mode}-${side}-${width}.png`)});
   await ball.press('Escape');await p.waitForFunction(()=>testHubVisual.inspect().phase==='closed');
  }
 }
 await p.setViewportSize({width:1280,height:900});await p.evaluate(()=>{hubPreview.stop();localStorage.removeItem('StoneFreeMotionHub.position.v1');hubPreview.floating.setPreference('mode','fan');hubPreview.remount()});
 await p.emulateMedia({reducedMotion:'no-preference'});fs.writeFileSync(path.join(out,'layout-matrix.json'),JSON.stringify(boxes,null,2));console.log('PASS actual Hub layout matrix',boxes.length,'rendered layouts');
}
async function previewLayout(p:playwright.Page,{oldPreviewCSS=null}:{oldPreviewCSS?:string|null}={}){
 // Recreate the reported selector leak without replacing settings or game code.
 if(oldPreviewCSS)await p.addStyleTag({content:oldPreviewCSS});
 for(const [width,height]of [[1280,900],[642,681],[390,844]] as const){
  await p.setViewportSize({width,height});await p.locator('#dol-midnight-sidebar-button').click();
  for(const layout of ['上下','左右']){
   await p.getByRole('button',{name:layout,exact:true}).click();
   for(const category of ['阅读','页面']){
    await p.locator('.dmt-workspace-nav').getByRole('button',{name:category,exact:true}).click();
    const data=await p.locator('.dmt-workspace-page').evaluate(n=>{const parent=n.parentElement;if(!parent)throw Error('Missing settings page parent');return{width:n.getBoundingClientRect().width,available:parent.getBoundingClientRect().width,padding:getComputedStyle(n).padding,maxWidth:getComputedStyle(n).maxWidth,marginLeft:getComputedStyle(n).marginLeft,marginRight:getComputedStyle(n).marginRight,sectionWidth:n.querySelector(':scope>section:not([inert])')?.getBoundingClientRect().width}});
    // Owner-requested compact workspace spacing; the old global main rule must still fail max-width/margin isolation.
    const approvedPadding=width<=620?'10px 12px':'12px 16px 16px';
    assert.ok(data.width>=Math.min(240,data.available*.6)&&data.padding===approvedPadding&&data.maxWidth==='none'&&data.marginLeft==='0px'&&data.marginRight==='0px'&&Number.isFinite(data.sectionWidth)&&typeof data.sectionWidth==='number'&&data.sectionWidth>0,'preview styles must not collapse actual settings content: '+JSON.stringify({viewport:{width,height},layout,category,...data}));
   }
  }
  await p.getByRole('button',{name:'上下',exact:true}).click();await p.locator('.dmt-close').click();await p.waitForFunction(()=>{const dialog=document.querySelector('dialog');if(!dialog)throw Error('Missing settings dialog');return !dialog.open});
  assert.equal(await p.evaluate(()=>getComputedStyle(document.documentElement).scrollbarWidth),'none','preview root scrollbar chrome is hidden');
  assert.ok(await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth),'preview must not overflow horizontally');
 }
 assert.equal(await p.evaluate(()=>hubPreview.counts().native),0,'opening settings must not count as native gameplay');
}
