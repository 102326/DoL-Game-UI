import playwright = require('playwright');
import assert = require('node:assert/strict');
import path = require('node:path');
const {chromium}=playwright;
function installProbe(){const probe={originalInput:document.querySelector('input'),changes:0},passages=document.querySelector('#passages');if(!probe.originalInput||!passages)throw Error('Missing native radio fixture');passages.addEventListener('change',()=>probe.changes++);Object.assign(window,{actionStyleProbe:probe});return probe}
declare const actionStyleProbe:ReturnType<typeof installProbe>;
(async()=>{const b=await chromium.launch({channel:'msedge',headless:true});try{const p=await b.newPage();await p.setContent(`<html data-dol-midnight><style>:root{--700:#444;--800:#222;--850:#191919;--900:#111;--link:#bcbcff}body{margin:12px}#next{position:fixed;bottom:-1px}#masturbationButtons{position:fixed;bottom:-1px}#masturbationButtons>div{display:inline-grid;border:1px solid}#masturbationButtons a{display:block;padding:10px 20px 30px}</style><div id="passages"><div class="passage"><p>Action choices</p><label><input type="radio" name="choice" checked>Option A</label> | <label><input type="radio" name="choice">A longer option that wraps on a narrow display</label><div id="masturbationButtons"><div id="next"><a href="#">Continue</a></div><div id="skip"><a href="#">Skip</a></div><div id="stop"><a href="#">Stop</a></div></div></div></div></html>`);await p.addStyleTag({path:path.join(__dirname,'../dist/game-ui.css')});await p.evaluate(installProbe);
for(const width of [390,1280])for(const scale of [.5,2]){await p.setViewportSize({width,height:844});await p.evaluate(s=>{document.documentElement.style.setProperty('--dgu-button-scale',String(s));document.body.style.fontSize=16*s+'px'},scale);assert.ok(await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));assert.equal(await p.locator('#next').evaluate(e=>getComputedStyle(e).borderTopWidth),'0px');assert.equal(await p.locator('#masturbationButtons').evaluate(e=>getComputedStyle(e).position),'sticky')}
await p.locator('label').nth(1).click();assert.equal(await p.evaluate(()=>actionStyleProbe.changes),1);assert.ok(await p.evaluate(()=>actionStyleProbe.originalInput===document.querySelector('input')));await p.evaluate(()=>document.documentElement.removeAttribute('data-dol-midnight'));assert.equal(await p.locator('#masturbationButtons').evaluate(e=>getComputedStyle(e).position),'fixed');console.log('PASS native radio identity/events, mobile and desktop 50/200% layout, button wrappers and theme rollback');}finally{await b.close()}})().catch(e=>{console.error(e);process.exitCode=1});
