 const browser=await playwright.chromium.launch(browserOptions),out=path.resolve('tests/artifacts/ui41/independent-'+Date.now()),results:unknown[]=[],errors:string[]=[];fs.mkdirSync(out,{recursive:true});let complete=false,failure:string|undefined;
