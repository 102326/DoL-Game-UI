 }catch(error){failure=error instanceof Error?error.message:String(error);throw error}finally{const changed=cp.execFileSync('git',['diff','--name-only','HEAD','--','src','framework','prototypes','tests'],{encoding:'utf8'}),untracked=cp.execFileSync('git',['ls-files','--others','--exclude-standard','--','src','framework','prototypes','tests'],{encoding:'utf8'});const sources=[...new Set([...(changed+'\n'+untracked).trim().split('\n').filter(Boolean),'tests/ui41-independent.cts','dist/framework/official-ui/style.css','dist/framework/official-ui/index.js'])],inputs=Object.fromEntries(sources.map(file=>[file,crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex')]));fs.writeFileSync(path.join(out,'result.json'),JSON.stringify({status:complete?'PASS':'FAIL',baseHead:cp.execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),workingTreeDirty:!!cp.execFileSync('git',['status','--porcelain'],{encoding:'utf8'}).trim(),inputs,failure,results,errors,scope:'Actual UI controllers/components with synthetic DOM and models; native game business, devices, GPU and sustained performance unverified.'},null,2));await browser.close();await server.close()}
