   await page.evaluate(()=>DoLMidnightTheme.setPreference('visualGlass',false));assert.equal(await root.evaluate(n=>getComputedStyle(n).backdropFilter),'none');await page.evaluate(()=>DoLMidnightTheme.setPreference('visualGlass',true));
   await page.evaluate(()=>DoLMidnightTheme.setPreference('fontScale',125));assert.ok(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1),'larger text does not overflow the page');await page.evaluate(()=>DoLMidnightTheme.setPreference('fontScale',100));assert.ok(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1),'no unexpected page overflow');await page.screenshot({path:path.join(out,kind+'-'+width+'.png')});results.push({width,kind,material,status:'PASS'});
