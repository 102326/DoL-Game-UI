import playwright = require('playwright');
import url = require('node:url');
import path = require('node:path');
import assert = require('node:assert/strict');
import type {GameUiControls} from '../src/runtime/game-controls';
const {chromium}=playwright,{pathToFileURL}=url;
declare const DoLGameUI:GameUiControls;
(async()=>{const b=await chromium.launch({channel:'msedge',headless:true});try{const p=await b.newPage();await p.goto(pathToFileURL(path.join(process.cwd(),'tests/fixture.html')).href);await p.waitForSelector('#listContainer');await p.evaluate(()=>localStorage.setItem('DoLMidnightTheme.preferences.v1',JSON.stringify({_scaleBaseline26:true,visualTier:0,visualGlass:true,visualMotion:true,comfortable:false,fontScale:115})));for(const name of ['host','official-ui']){if(name==='official-ui')await p.addStyleTag({path:'dist/framework/official-ui/style.css'});await p.addScriptTag({path:`dist/framework/${name}/index.js`})}await p.waitForFunction(()=>typeof DoLGameUI!=='undefined');await p.evaluate(()=>DoLGameUI.openSettings());assert.equal(await p.evaluate(()=>DoLGameUI.getPreferences().visualTier),0);assert.equal(await p.evaluate(()=>{if(!DoLGameUI.ui)throw Error('Official UI API missing');return DoLGameUI.ui.getVisualTier()}),'Fancy');assert.equal(await p.evaluate(()=>document.documentElement.hasAttribute('data-dgu-visualGlass')),true);assert.equal(await p.evaluate(()=>DoLGameUI.getPreferences().fontScale),115);assert.equal(await p.locator('.dmt-workspace-nav button').count(),5);assert.equal(await p.locator('#dol-midnight-controls').evaluate(n=>getComputedStyle(n).getPropertyValue('--dgu-accent').trim()),'#c9c9cd');assert.equal(await p.locator('.dmt-eyebrow').first().evaluate(n=>getComputedStyle(n).color),'rgb(201, 201, 205)');assert.equal(await p.locator('.dmt-controls-content').evaluate(n=>getComputedStyle(n).backgroundColor),'rgba(0, 0, 0, 0)');await p.waitForTimeout(600);await p.locator('.dmt-close').click();await p.evaluate(()=>DoLGameUI.openSettings());await p.waitForTimeout(400);assert.equal(await p.locator('#dol-midnight-controls').evaluate(n=>{if(!(n instanceof HTMLDialogElement))throw Error('Settings dialog missing');return n.open}),true,'reopen cancels pending close');await p.locator('.dmt-close').click();await p.waitForFunction(()=>{const dialog=document.querySelector('#dol-midnight-controls');return dialog instanceof HTMLDialogElement&&!dialog.open});await p.evaluate(()=>{DoLGameUI.setPreference('visualMotion',false);DoLGameUI.openSettings()});await p.locator('.dmt-close').click();assert.equal(await p.locator('#dol-midnight-controls').evaluate(n=>{if(!(n instanceof HTMLDialogElement))throw Error('Settings dialog missing');return n.open}),false);assert.equal(await p.locator('[data-sf-leaving]').count(),0);console.log('PASS legacy tier0 preserved/full official effects, modal close/reopen cancellation and no-motion cleanup; official settings initial mount before data-stone-free assignment; actual official bundle + Host');}finally{await b.close()}})().catch(e=>{console.error(e);process.exitCode=1});
