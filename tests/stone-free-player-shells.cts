import playwright = require('playwright');
import esbuild = require('esbuild');
import fs = require('node:fs');
import assert = require('node:assert/strict');
import type {createSidebarLayout} from '../src/theme/sidebar-layout';
const {chromium}=playwright,{buildSync}=esbuild;
declare const Sidebar:{createSidebarLayout:typeof createSidebarLayout},layout:ReturnType<typeof createSidebarLayout>,nodes:Element[];declare let exits:number;
function must<T>(value:T|null|undefined):T{if(value===null||value===undefined)throw Error('Missing player shell fixture');return value}
(async()=>{const browser=await chromium.launch({channel:'msedge',headless:true});try{
 const page=await browser.newPage({viewport:{width:1000,height:900}});
 await page.setContent(`<html data-stone-free="3.0.0" data-dol-midnight data-dmt-layout data-dgu-visual="2" data-dgu-visualGlass><style>body{background:#111;color:white}#ui-bar{width:250px}button{border:1px solid #888;border-radius:0}#foreign{background:rgb(120,40,80)}</style><aside id="ui-bar"><div id="startCaption"><h3>Game</h3><button class="link-internal">Saves</button><div class="sidebarButtonSplit"><button class="link-internal">Options</button><button class="link-internal">Feats</button></div><span class="modhub-sidebar-entry"><button class="link-internal">ModHub</button></span><button id="dol-midnight-sidebar-button">Settings</button><button id="foreign">Unknown Mod</button></div></aside><main class="dgshop-content" style="padding:20px"><p>Native introduction</p><a id="native-exit" href="#exit">Leave</a></main><dialog id="dol-midnight-controls"><div class="dmt-controls-content"><section class="dmt-setting-card"><h3>Theme</h3><label class="dgu-setting-row"><span>Glass</span><input type="checkbox"></label></section><section class="dmt-setting-card"><h3>Layout</h3></section></div></dialog></html>`);
 const native=await page.evaluate(()=>{const exit=document.querySelector<HTMLAnchorElement>('#native-exit'),caption=document.querySelector('#startCaption');if(!exit||!caption)throw Error('Missing native shell');Object.assign(window,{nodes:[...document.querySelectorAll('#startCaption *')],exits:0});exit.onclick=e=>{e.preventDefault();exits++};return caption.innerHTML});
 for(const file of ['src/theme/controls.css','src/theme/kraft-work-surfaces.css','src/theme/sidebar.css','src/theme/stone-free.css'])await page.addStyleTag({path:file});
 await page.addScriptTag({content:must(buildSync({entryPoints:['src/theme/sidebar-layout.ts'],bundle:true,write:false,format:'iife',globalName:'Sidebar'}).outputFiles[0]).text});
 await page.evaluate(()=>{if(typeof Sidebar?.createSidebarLayout!=='function')throw Error('Missing sidebar factory');Object.assign(window,{layout:Sidebar.createSidebarLayout()});layout.sync(true);layout.sync(true)});
 assert.equal(await page.locator('.dmt-start-tools').count(),1);
 for(const selector of ['#startCaption>button.link-internal','.sidebarButtonSplit>button.link-internal','.modhub-sidebar-entry>button','#dol-midnight-sidebar-button'])assert.equal(await page.locator(selector).first().evaluate(n=>getComputedStyle(n).borderRadius),'10px',selector);
 assert.equal(await page.locator('#foreign').evaluate(n=>getComputedStyle(n).backgroundColor),'rgb(120, 40, 80)');
 assert.equal(await page.locator('.dgshop-content').evaluate(n=>getComputedStyle(n).isolation),'isolate');
 assert.equal(await page.locator('.dgshop-content').evaluate(n=>getComputedStyle(n,'::before').zIndex),'-1');
 await page.locator('#native-exit').click();assert.equal(await page.evaluate(()=>exits),1);
 await page.evaluate(()=>(()=>{const dialog=document.querySelector('dialog');if(!dialog)throw Error('Missing settings dialog');dialog.showModal()})());
 assert.equal(await page.locator('.dmt-setting-card').first().evaluate(n=>getComputedStyle(n).backgroundColor),'rgba(0, 0, 0, 0)');
 assert.equal(await page.locator('.dmt-controls-content').evaluate(n=>getComputedStyle(n).gridTemplateColumns.split(' ').length),1);
 const input=page.locator('.dgu-setting-row input');await page.locator('.dgu-setting-row').click();assert.equal(await input.isChecked(),true);assert.equal(await input.evaluate(n=>n instanceof HTMLInputElement?n.type:''),'checkbox');
 await page.setViewportSize({width:390,height:844});assert.equal(await page.locator('dialog').evaluate(n=>n.scrollWidth<=n.clientWidth),true);
 await page.evaluate(()=>{const dialog=document.querySelector('dialog');if(!dialog)throw Error('Missing settings dialog');dialog.close();layout.destroy()});assert.equal(await page.locator('#startCaption').innerHTML(),native);assert.equal(await page.evaluate(()=>nodes.every(n=>n.isConnected)),true);
 await page.addStyleTag({path:'framework/motion-hub/style.css'});
 await page.evaluate(()=>{document.body.insertAdjacentHTML('beforeend','<div id="customOverlay" class="hidden"></div><div class="tooltip-popup" data-tooltip-id="test" style="position:fixed;top:0;left:0;width:100px;height:100px;pointer-events:auto">Native tooltip</div><div class="sf-motion-hub"><button class="sf-motion-ball" style="transform:translate(12px,12px)">Hub</button></div>')});
 assert.equal(await page.evaluate(()=>document.elementFromPoint(40,40)?.closest('.sf-motion-ball')!==null),true,'shop tooltip must not cover the Hub hitbox');
 await page.evaluate(()=>document.querySelector('#customOverlay')?.classList.remove('hidden'));
 assert.equal(await page.locator('.sf-motion-hub').evaluate(n=>getComputedStyle(n).zIndex),'970','native panels keep their previous layer priority');
 await page.addStyleTag({path:'src/shop/style.css'});
 await page.evaluate(()=>{document.querySelector('.sf-motion-hub')?.remove();document.querySelector('.tooltip-popup')?.remove();document.querySelector('#customOverlay')?.classList.add('hidden');const shop=document.querySelector<HTMLElement>('.dgshop-content');if(!shop)throw Error('Missing native shop');shop.classList.add('dgshop-narrow');shop.insertAdjacentHTML('beforeend','<div class="dgshop-layout"><div class="clothing-details dgshop-detail-open"><button class="dgshop-close-detail">Back</button></div></div>');document.body.insertAdjacentHTML('beforeend','<button class="dgshop-detail-backdrop" aria-label="Close details"></button>');const close=document.querySelector<HTMLButtonElement>('.dgshop-close-detail');if(!close)throw Error('Missing detail button');close.onclick=()=>{document.querySelector('.clothing-details')?.classList.remove('dgshop-detail-open');const backdrop=document.querySelector<HTMLElement>('.dgshop-detail-backdrop');if(!backdrop)throw Error('Missing detail backdrop');backdrop.hidden=true}});
 assert.equal(await page.locator('.dgshop-close-detail').evaluate(n=>{const r=n.getBoundingClientRect();return n.contains(document.elementFromPoint(r.x+r.width/2,r.y+r.height/2))}),true,'drawer controls must be above their backdrop');
 assert.equal(await page.evaluate(()=>document.elementFromPoint(195,5)?.classList.contains('dgshop-detail-backdrop')),true,'blank area must still close through the backdrop');
 await page.locator('.dgshop-close-detail').click();assert.equal(await page.locator('.clothing-details').evaluate(n=>n.classList.contains('dgshop-detail-open')),false);
 console.log('PASS native paint layer, Start navigation identity/fallback, unknown Mod boundary and settings sections/native switch');
}finally{await browser.close()}})().catch(e=>{console.error(e);process.exitCode=1});
