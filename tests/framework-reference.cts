import fs = require('node:fs');
import path = require('node:path');
import assert = require('node:assert/strict');
import playwright = require('playwright');
import esbuild = require('esbuild');
import type {Host} from '../framework/contracts';
declare const ReferenceSource:Pick<typeof import('../framework/wardrobe-reference/source'),'readWardrobe'>;
declare const ReferenceHost:Pick<typeof import('../framework/host'),'createHost'>;
declare const WardrobeReferenceTest:Pick<typeof import('../framework/wardrobe-reference/main'),'dispose'>;
declare const DoLUiHost:Host;
type FixtureItem={name:string;variable:string;colour:string;integrity:number;reveal:number;warmth:number};
type NativeState={worn:{upper:{name:string}};wardrobe:Record<string,FixtureItem[]>;location:string};
declare const nativeState:NativeState,expected:string; declare let nativeClicks:number;
const {chromium}=playwright,{buildSync}=esbuild;
const must=<T,>(value:T|null|undefined):T=>{if(value==null)throw Error('Missing reference fixture value');return value};
const root=path.resolve(__dirname,'..'),dir=path.join(root,'tests/artifacts/stone-free-reference','browser-'+Date.now());fs.mkdirSync(dir,{recursive:true});
const fixture=`<!doctype html><meta charset="utf-8"><body><div id="passages"><section class="passage" data-passage="Wardrobe"><div id="wardrobeList"><button>Original wardrobe action</button></div></section></div></body>`;
const sourceBundle=path.join(dir,'source.js'),hostBundle=path.join(dir,'host.js');
buildSync({entryPoints:[path.join(root,'framework/wardrobe-reference/source.ts')],bundle:true,format:'iife',globalName:'ReferenceSource',platform:'browser',outfile:sourceBundle});
buildSync({entryPoints:[path.join(root,'framework/host.ts')],bundle:true,format:'iife',globalName:'ReferenceHost',platform:'browser',outfile:hostBundle});
(async()=>{
 const {build}=await import('vite'),vue=(await import('@vitejs/plugin-vue')).default;
 const output=path.join(dir,'app');
 await build({root,configFile:false,plugins:[vue()],define:{'process.env.NODE_ENV':JSON.stringify('production'),__VUE_OPTIONS_API__:false,__VUE_PROD_DEVTOOLS__:false,__VUE_PROD_HYDRATION_MISMATCH_DETAILS__:false},build:{target:'es2022',outDir:output,emptyOutDir:true,lib:{entry:path.join(root,'framework/wardrobe-reference/main.ts'),name:'WardrobeReferenceTest',formats:['iife'],fileName:()=> 'index.js',cssFileName:'style'},minify:true}});
 const browser=await chromium.launch({channel:'msedge',headless:true});
 try {
  const page=await browser.newPage({viewport:{width:1280,height:900}}),errors:string[]=[];page.setDefaultTimeout(5000);page.on('pageerror',e=>errors.push(e.message));
  await page.route('http://reference.test/',r=>r.fulfill({contentType:'text/html',body:fixture}));await page.goto('http://reference.test/');
  await page.addScriptTag({path:sourceBundle});await page.addScriptTag({path:hostBundle});
  const initial=must(await page.evaluate(()=>{
   const items=Array.from({length:40},(_,i)=>({name:`coat-${i}`,variable:`coat-${i}`,colour:i%2?'blue':'green',integrity:8,reveal:i,warmth:i}));
   const nativeState:NativeState={worn:{upper:{name:'worn-original'}},wardrobe:{upper:items,feet:[]},location:'wardrobe'};
   const nativeSetup={clothes:{upper:items.map((item,i)=>({variable:item.variable,name:`coat-${i}`,warmth:i,integrity_max:10,description:`detail-${i}`})),feet:[]}};
   Object.assign(window,{nativeState,nativeSetup,SugarCube:{State:{variables:nativeState,passage:'Wardrobe'},setup:nativeSetup},State:{variables:nativeState,passage:'Wardrobe'},setup:nativeSetup});
   Object.assign(window,{expected:JSON.stringify(nativeState),DoLUiHost:ReferenceHost.createHost(window)});
   return ReferenceSource.readWardrobe(window);
  }));
  assert.equal(must(initial.categories[0]).items.length,40);assert.equal(must(must(initial.categories[0]).items[0]).name,'coat-0');
  assert.deepEqual(Object.keys(must(must(initial.categories[0]).items[0])).sort(),['colour','detail','durability','key','lewd','name','outfit','slot','warmth'].sort());
  await page.addStyleTag({path:path.join(output,'style.css')});await page.addScriptTag({path:path.join(output,'index.js')});
  const launch=page.getByRole('button',{name:'衣柜参考空间'});await launch.waitFor();await launch.click();
  const panel=page.getByRole('dialog',{name:'衣柜参考空间'});await panel.waitFor();
  const wide=must(await panel.boundingBox());assert.ok(wide.x>=0&&wide.y>=0&&wide.x+wide.width<=1280&&wide.y+wide.height<=900,JSON.stringify(wide));
  const outside=await page.locator('#wardrobeList button').evaluate(n=>{n.focus();const event=new KeyboardEvent('keydown',{key:'Escape',bubbles:true,cancelable:true});n.dispatchEvent(event);return event.defaultPrevented});assert.equal(outside,false);assert.equal(await panel.count(),1);
  const search=panel.getByRole('searchbox',{name:'搜索'});await search.fill('coat');
  const list=panel.locator('.sf-wardrobe-reference-list');
  const rows=panel.locator('.sf-wardrobe-reference-item');await rows.nth(0).getByRole('button',{name:'固定 A'}).click();
  const bButton=rows.nth(1).locator('[data-select-b]');await bButton.click();
  await list.evaluate(n=>n.scrollTop=300);
  assert.equal(await panel.getByRole('button',{name:'普通比较'}).isDisabled(),false,await page.locator('body').innerText());
  await panel.getByRole('button',{name:'普通比较'}).click();
  const ordinary=await panel.locator('.sf-wardrobe-reference-comparison').innerText();assert.match(ordinary,/coat-0/);assert.match(ordinary,/coat-1/);
  await panel.getByRole('button',{name:'返回目录'}).click();await bButton.waitFor();
  assert.equal(await search.inputValue(),'coat');assert.equal(await list.evaluate(n=>n.scrollTop),300);await page.waitForFunction(()=>document.activeElement?.matches('[data-select-b]'));
  await panel.getByRole('button',{name:'空间比较'}).click();await panel.locator('.sf-wardrobe-reference-comparison').waitFor();
  const spatial=await panel.locator('.sf-wardrobe-reference-comparison').innerText();assert.equal(spatial,ordinary);
  await panel.getByRole('button',{name:'返回目录'}).click();await page.waitForFunction(()=>document.activeElement?.matches('[data-select-b]'));
  const unchanged=await page.evaluate(()=>JSON.stringify(nativeState)===expected);assert.equal(unchanged,true);
  await page.setViewportSize({width:390,height:844});await panel.getByRole('button',{name:'空间比较'}).click();
  const box=must(await panel.boundingBox());assert.ok(box.x>=0&&box.y>=0&&box.x+box.width<=390&&box.y+box.height<=844,JSON.stringify(box));
  await page.emulateMedia({reducedMotion:'reduce'});assert.equal(await panel.evaluate(n=>getComputedStyle(n).transitionDuration),'0s');
  await page.evaluate(()=>DoLUiHost.invalidateScene());await launch.waitFor({state:'detached'});assert.equal(await panel.count(),0);
  await page.evaluate(()=>{nativeState.wardrobe={};document.querySelector('.passage')!.remove();document.querySelector('#passages')!.insertAdjacentHTML('beforeend','<section class="passage" data-passage="Wardrobe"><div id="wardrobeList"><button>Original wardrobe action</button></div></section>');DoLUiHost.sceneReady()});
  await launch.waitFor();await launch.click();await page.getByText(/没有可读取的衣柜清单/).waitFor();
  await panel.getByRole('button',{name:'关闭衣柜参考空间'}).click();await page.evaluate(()=>{Object.assign(window,{nativeClicks:0});document.querySelector('#wardrobeList button')!.addEventListener('click',()=>{nativeClicks++})});await page.locator('#wardrobeList button').click();assert.equal(await page.evaluate(()=>nativeClicks),1);
  await page.evaluate(()=>WardrobeReferenceTest.dispose());await page.waitForTimeout(40);assert.equal(await page.locator('.sf-wardrobe-reference-launch').count(),0);assert.deepEqual(errors,[]);
  await page.close();fs.writeFileSync(path.join(dir,'result.json'),JSON.stringify({status:'passed',limits:['Labeled browser fixture only; not a live DoL wardrobe or Mod-added slot matrix']},null,2));console.log(dir);
 }finally{await browser.close()}
})().catch(e=>{fs.writeFileSync(path.join(dir,'failure.json'),JSON.stringify({status:'failed',error:e instanceof Error?e.message:String(e)},null,2));console.error(e);process.exitCode=1});
