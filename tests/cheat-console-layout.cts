import playwright = require('playwright');
import assert = require('node:assert/strict');
import path = require('node:path');
const {chromium}=playwright;
function installCheatProbe(){
 const overlay=document.getElementById('customOverlay');if(!overlay)throw Error('Missing cheat overlay');
 const probe={overlay,nodes:[...document.querySelectorAll('input,button')],inputs:0,executions:0};
 document.querySelectorAll('input').forEach(n=>n.addEventListener('input',()=>probe.inputs++));document.querySelectorAll('button').forEach(n=>n.addEventListener('click',()=>probe.executions++));Object.assign(window,{cheatProbe:probe});return probe;
}
declare const cheatProbe:ReturnType<typeof installCheatProbe>;
(async()=>{const b=await chromium.launch({channel:'msedge',headless:true});try{const p=await b.newPage();await p.setContent(`<style>.macro-button{width:100%;max-width:260px}.input-row{display:flex;gap:8px}.input-row input{flex:1;min-width:0}#customOverlay{width:calc(100% - 24px);margin:12px}#customOverlayContent{padding:8px}body{margin:0}</style><html data-dol-midnight><div id="customOverlay" class="dgp-overlay" data-dgp-panel="cheats"><div id="customOverlayContent">${['js','twine'].map(id=>`<details open><summary>${id}</summary><div class="searchButtons"><div class="input-row"><input type="text" id="${id}"/><button class="macro-button">执行</button></div></div></details>`).join('')}</div></div>`);await p.addStyleTag({path:path.resolve(__dirname,'../dist/game-ui.css')});await p.evaluate(installCheatProbe);
assert.equal(await p.locator('#customOverlay').evaluate(e=>getComputedStyle(e).getPropertyValue('--dgu-panel').trim()),'rgba(29,30,34,.72)');
for(const width of [390,1363])for(const size of [16,32]){await p.setViewportSize({width,height:876});await p.evaluate(size=>cheatProbe.overlay.style.fontSize=size+'px',size);for(const id of ['js','twine']){const input=p.locator('#'+id);await input.fill('layout-check-only');const rect=await input.evaluate(n=>{const next=n.nextElementSibling,parent=n.parentElement;if(!next||!parent)throw Error('Missing cheat row');const a=n.getBoundingClientRect(),b=next.getBoundingClientRect(),r=parent.getBoundingClientRect();return{input:a.width,button:b.width,row:r.width,within:a.left>=r.left&&b.right<=r.right+1}});assert.ok(rect.input>100,JSON.stringify(rect));assert.ok(rect.button<rect.row/2,JSON.stringify(rect));assert.equal(rect.within,true)} }
await p.evaluate(()=>{cheatProbe.overlay.classList.remove('dgp-overlay')});assert.equal(await p.locator('#js').inputValue(),'layout-check-only');assert.equal(await p.locator('#customOverlay').evaluate(e=>getComputedStyle(e).getPropertyValue('--dgu-panel')),await p.locator('html').evaluate(e=>getComputedStyle(e).getPropertyValue('--dgu-panel')));assert.equal(await p.evaluate(()=>cheatProbe.nodes.every(n=>n.isConnected)&&cheatProbe.executions===0&&cheatProbe.inputs>0),true);await p.evaluate(()=>cheatProbe.overlay.classList.add('dgp-overlay'));assert.equal(await p.evaluate(()=>cheatProbe.nodes.every(n=>n.isConnected)),true);console.log('PASS two cheat input rows, phone/tablet, 100%/200% font, input events, node identity and fallback; no execution');
}finally{await b.close()}})().catch(e=>{console.error(e);process.exitCode=1});
