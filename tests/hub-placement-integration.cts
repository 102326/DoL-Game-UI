   const focusBefore=await p.evaluate(()=>testPlacementVisual.inspect());await outside.evaluate((el:HTMLElement)=>el.focus({preventScroll:true}));await p.waitForTimeout(150);const focusAfter=await p.evaluate(()=>testPlacementVisual.inspect());const pointerPoint=must(await outside.evaluate(el=>{const r=el.getBoundingClientRect();for(const x of [.1,.9,.5])for(const y of [.1,.9,.5]){const px=r.x+r.width*x,py=r.y+r.height*y,hit=document.elementFromPoint(px,py);if(hit&&el.contains(hit))return{x:px,y:py}}return null}));const pointerBefore=focusAfter;await p.mouse.click(pointerPoint.x,pointerPoint.y);await p.waitForTimeout(150);const pointerAfter=await p.evaluate(()=>testPlacementVisual.inspect()),outsideEvents=await p.evaluate(()=>Reflect.get(window,'idleOutsideEvents') as {type:string;trusted:boolean}[]);rows.push({width,focusBefore,focusAfter,pointerBefore,pointerAfter,outsideEvents});assert.ok(outsideEvents.some(e=>e.type==='focusin'&&e.trusted)&&outsideEvents.some(e=>e.type==='pointerdown'&&e.trusted),'external focus and pointer must be real');assert.equal(focusAfter.draws,focusBefore.draws,'external focus must not wake resting visual');assert.equal(pointerAfter.draws,pointerBefore.draws,'external pointer must not wake resting visual');
