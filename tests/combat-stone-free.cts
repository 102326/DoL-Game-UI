  assert.equal(await page.evaluate(()=>original.input.isConnected),true);assert.equal(await page.evaluate(()=>original.events),1);
  assert.equal(await page.evaluate(()=>testFramework.host.getDiagnostics().claims.length),0,'owner disposal releases the claim');
