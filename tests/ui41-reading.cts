import type {createReadingLayout} from '../src/theme/reading-layout';
import type {Preferences,PreferenceKey} from '../src/theme/preferences';
type Theme={openSettings():void;setPreference(key:PreferenceKey,value:number|boolean):void;getPreferences():Preferences;destroy():void};
declare const reading:ReturnType<typeof createReadingLayout>,theme:Theme,startReadingTheme:()=>void,readingObservers:()=>number,restoreReadingObserver:()=>void;
declare const nativeReadingNodes:Node[],nativeCalls:number;
const {caseCheckpoint}=cases;
async function verifyReading(browser:playwright.Browser,{baseline=false}={}){
 const {createServer}=await import('vite'),vue=(await import('@vitejs/plugin-vue')).default,root=process.cwd();
 const markup='<main id="story"><div id="passages"><article class="passage"><div id="passage-content"><h2 id="reading-heading">Large heading</h2><p id="reading-paragraph">Original native paragraph with several words and lines.</p><p id="reading-normal" style="font-size:30px;line-height:normal">Normal height</p><div class="options" id="reading-options"><button id="reading-native">Native action</button><button>Other action</button></div><div id="reading-breaks">First line<br>Second line</div></div></article></div></main>';
 const server=await createServer({configFile:false,plugins:[vue(),{name:'reading-contract',enforce:'pre',load(id){if(baseline&&id===path.resolve('src/theme/kraft-work-native.css'))return cp.execFileSync('git',['show','7d61a7e:src/theme/kraft-work-native.css'],{encoding:'utf8'})},configureServer(s){s.middlewares.use('/__reading_contract__',(_q,r)=>{r.setHeader('Content-Type','text/html');r.end(`<!doctype html><html data-stone-free data-dol-midnight><link rel="stylesheet" href="/dist/framework/official-ui/style.css"><meta name="viewport" content="width=device-width,initial-scale=1"><style>body{margin:16px;font:16px/1.45 system-ui}#story{margin:0;max-width:100%}#passages{max-width:600px;margin:auto}.passage{line-height:1.45}h2{font-size:32px;margin:0}p{margin:0 0 8px}#reading-paragraph{line-height:1.7}.options{display:grid;row-gap:6px;margin:0 0 8px}button{min-height:44px}</style><body>${markup}</body></html>`)})}}],server:{host:'127.0.0.1',port:0},logLevel:'error'});
 await server.listen();const address=server.httpServer?.address();assert.ok(address&&typeof address!=='string');const url='http://127.0.0.1:'+address.port+'/__reading_contract__',rows:unknown[]=[],out=path.resolve('tests/artifacts/ui41/reading-'+Date.now());fs.mkdirSync(out,{recursive:true});
 const frames=(p:playwright.Page)=>p.evaluate(()=>new Promise<void>(r=>requestAnimationFrame(()=>requestAnimationFrame(()=>r()))));
 const init=async(p:playwright.Page)=>{await p.goto(url);await p.evaluate(async()=>{
  const [{createReadingLayout},{startTheme},{startLayout}]=await Promise.all([import('/src/theme/reading-layout.ts'),import('/src/theme/controller.ts'),import('/src/theme/layout.ts')]);await import('/src/theme/kraft-work-native.css');await import('/src/theme/layout.css');
  const Native=MutationObserver,live=new Set<MutationObserver>();class Counted extends Native{override observe(...args:Parameters<MutationObserver['observe']>){if(args[0] instanceof Element&&(args[0].id==='passages'||args[0].id==='story'))live.add(this);super.observe(...args)}override disconnect(){live.delete(this);super.disconnect()}}
  Object.assign(window,{MutationObserver:Counted,reading:createReadingLayout(),readingObservers:()=>live.size,restoreReadingObserver:()=>Object.assign(window,{MutationObserver:Native}),startReadingTheme:()=>{startLayout();startTheme();Reflect.set(window,'theme',Reflect.get(window,'DoLMidnightTheme'))},nativeReadingNodes:[...document.querySelectorAll('#passages *')],nativeCalls:0});document.getElementById('reading-native')!.onclick=()=>Reflect.set(window,'nativeCalls',Reflect.get(window,'nativeCalls')+1);
 })};
 const sample=(p:playwright.Page)=>p.evaluate(()=>{const n=(id:string)=>{const e=document.getElementById(id);if(!e)throw Error('Missing reading fixture '+id);return e},line=(e:Element)=>parseFloat(getComputedStyle(e).lineHeight),passage=n('passages').querySelector<HTMLElement>('.passage')!;return{line:line(passage),heading:line(n('reading-heading')),paragraph:line(n('reading-paragraph')),margin:parseFloat(getComputedStyle(n('reading-paragraph')).marginBlockEnd),gap:parseFloat(getComputedStyle(n('reading-options')).rowGap),width:n('passages').getBoundingClientRect().width,normal:n('reading-normal').getBoundingClientRect().height,inline:passage.style.lineHeight}});
 try{
  const p=await browser.newPage({viewport:{width:1100,height:950},reducedMotion:'reduce'});try{
   await init(p);const native=await sample(p);assert.ok(Math.abs(native.line-16*1.45)<.1,'default must inherit controlled native line height, not the old Mod override');
   await p.evaluate(()=>reading.update({enabled:true,readingLineScale:100,readingBlockGap:0,readingWidth:0}));await frames(p);assert.deepEqual(await sample(p),native);assert.equal(await p.evaluate(()=>readingObservers()),0,'default has no observer');
   caseCheckpoint('native-default');
   await p.evaluate(()=>reading.update({enabled:true,readingLineScale:150,readingBlockGap:8,readingWidth:100}));await frames(p);const adjusted=await sample(p);
   for(const key of ['line','heading','paragraph','normal'] as const)assert.ok(Math.abs(adjusted[key]-native[key]*1.5)<.2,key+' preserves relative font metrics');
   assert.equal(adjusted.margin,native.margin+8);assert.equal(adjusted.gap,native.gap+8);assert.ok(adjusted.width>native.width);assert.equal(await p.evaluate(()=>readingObservers()),1);
   await p.locator('#reading-native').click();assert.equal(await p.evaluate(()=>nativeCalls),1);assert.equal(await p.evaluate(()=>nativeReadingNodes.every(n=>n.isConnected)),true);
   await p.evaluate(()=>reading.update({enabled:true,readingLineScale:150,readingBlockGap:8,readingWidth:100}));await frames(p);assert.deepEqual(await sample(p),adjusted,'updates cannot accumulate');
   await p.evaluate(()=>{document.getElementById('reading-paragraph')!.style.fontSize='24px';reading.refresh()});await frames(p);assert.ok(Math.abs((await sample(p)).paragraph-24*1.7*1.5)<.2);
   await p.evaluate(()=>document.getElementById('passage-content')!.insertAdjacentHTML('beforeend','<p id="added-reading">New paragraph</p>'));await frames(p);assert.equal(await p.locator('#added-reading').evaluate(n=>parseFloat(getComputedStyle(n).marginBlockEnd)),16);
   await p.evaluate(()=>{Reflect.set(window,'oldReadingRoot',document.getElementById('passages'));document.getElementById('passages')!.remove()});await frames(p);await p.evaluate(()=>{const old=Reflect.get(window,'oldReadingRoot') as HTMLElement;document.getElementById('story')!.append(old.cloneNode(true))});await frames(p);assert.ok(Math.abs((await sample(p)).line-native.line*1.5)<.2,'cross-frame root replacement resumes without game events');
   await p.evaluate(()=>{const story=document.getElementById('story')!;Reflect.set(window,'readingStory',story);story.remove()});await frames(p);await p.evaluate(()=>document.body.prepend((Reflect.get(window,'readingStory') as HTMLElement).cloneNode(true)));await frames(p);assert.ok(Math.abs((await sample(p)).line-native.line*1.5)<.2,'whole story replacement resumes without game events');
   await p.evaluate(()=>reading.update({enabled:true,readingLineScale:100,readingBlockGap:0,readingWidth:0}));await frames(p);assert.equal(await p.evaluate(()=>readingObservers()),0,'default releases observers after root replacement');
   await p.evaluate(()=>document.querySelector('.passage')!.insertAdjacentHTML('beforeend','<section data-sf-owner="foreign" id="reading-island"><h2>Foreign typography</h2></section>'));const islandBefore=await p.locator('#reading-island').evaluate(n=>({width:n.getBoundingClientRect().width,line:getComputedStyle(n).lineHeight,heading:getComputedStyle(n.querySelector('h2')!).lineHeight}));
   await p.evaluate(()=>reading.update({enabled:true,readingLineScale:150,readingBlockGap:8,readingWidth:100}));await frames(p);assert.deepEqual(await p.locator('#reading-island').evaluate(n=>({width:n.getBoundingClientRect().width,line:getComputedStyle(n).lineHeight,heading:getComputedStyle(n.querySelector('h2')!).lineHeight})),islandBefore,'marked islands keep native typography and available width');
   await p.evaluate(()=>{document.getElementById('reading-island')!.remove();document.querySelector('.passage')!.insertAdjacentHTML('beforeend','<section class="dcu-root" id="fallback-combat"><h2>Fallback combat</h2></section>')});await frames(p);assert.equal((await sample(p)).inline,'','framework-free combat keeps its own passage typography');assert.equal((await sample(p)).width,native.width,'framework-free combat keeps original available width');
   await p.evaluate(()=>document.getElementById('fallback-combat')!.remove());await frames(p);await p.evaluate(()=>{document.getElementById('reading-paragraph')!.style.marginBlockEnd='99px';document.getElementById('passages')!.style.maxWidth='900px';reading.update({enabled:false,readingLineScale:150,readingBlockGap:8,readingWidth:100})});await frames(p);assert.equal(await p.locator('#reading-paragraph').evaluate(n=>n.style.marginBlockEnd),'99px');assert.equal(await p.locator('#passages').evaluate(n=>n.style.maxWidth),'900px');assert.equal(await p.evaluate(()=>readingObservers()),0);await p.evaluate(()=>{const original=MutationObserver.prototype.observe;Reflect.set(window,'readingObserveRestore',()=>{MutationObserver.prototype.observe=original});MutationObserver.prototype.observe=function(target,options){if(target instanceof Element&&target.id==='story')throw Error('controlled partial observer failure');return original.call(this,target,options)};reading.update({enabled:true,readingLineScale:150,readingBlockGap:8,readingWidth:100})});await frames(p);assert.equal(await p.evaluate(()=>readingObservers()),0,'partial observation failure disconnects acquired targets');await p.evaluate(()=>{Reflect.get(window,'readingObserveRestore')();reading.destroy()});
   rows.push({native,adjusted,islandBefore});caseCheckpoint('native-adjustment-and-release');
  }finally{await p.close()}
  for(const width of [390,1100]){
   const p=await browser.newPage({viewport:{width,height:1000},reducedMotion:'reduce'});try{
    await init(p);await p.evaluate(()=>{reading.destroy();restoreReadingObserver();localStorage.setItem('DoLMidnightTheme.preferences.v1',JSON.stringify({_scaleBaseline26:true,comfortable:true,wideReading:true,fontScale:125,buttonScale:100,acrylicTransparency:60}));startReadingTheme();theme.openSettings()});await p.getByRole('slider',{name:'正文行距',exact:true}).waitFor();
    const migrated=await p.evaluate(()=>theme.getPreferences());assert.equal(migrated.comfortable,false);assert.equal(migrated.wideReading,false);assert.equal(migrated.readingLineScale,100);assert.equal(migrated.readingBlockGap,0);assert.equal(migrated.readingWidth,0);assert.equal(migrated.fontScale,125);assert.equal(await p.getByLabel('舒适阅读间距',{exact:true}).count(),0);assert.equal(await p.getByLabel('宽幅正文',{exact:true}).count(),0);
    await p.getByRole('slider',{name:'正文行距',exact:true}).fill('115');await p.getByRole('slider',{name:'段落与选项间距',exact:true}).fill('10');await p.getByRole('slider',{name:'正文宽度',exact:true}).fill('70');await frames(p);
    const chosen=await p.evaluate(()=>theme.getPreferences());assert.equal(chosen.readingLineScale,115);assert.equal(chosen.readingBlockGap,10);assert.equal(chosen.readingWidth,70);assert.equal(await p.locator('.dmt-reading-demo').evaluate(n=>n instanceof HTMLElement&&n.style.width),'91.6%');
    const line=p.getByRole('slider',{name:'正文行距',exact:true});await line.focus();await p.keyboard.press('ArrowRight');assert.equal(await line.inputValue(),'120');await p.keyboard.press('ArrowLeft');
    await p.getByRole('button',{name:'恢复原版排版',exact:true}).click();await frames(p);assert.deepEqual(await p.evaluate(()=>theme.getPreferences()),migrated,'reset affects only reading values');
    await p.evaluate(()=>{theme.setPreference('comfortable',true);theme.setPreference('wideReading',true);for(const key of ['readingLineScale','readingBlockGap','readingWidth'] as const){theme.setPreference(key,NaN);theme.setPreference(key,Infinity);theme.setPreference(key,true)}});assert.deepEqual(await p.evaluate(()=>theme.getPreferences()),migrated);
    await p.evaluate(()=>{theme.setPreference('readingLineScale',999);theme.setPreference('readingBlockGap',999);theme.setPreference('readingWidth',999)});const capped=await p.evaluate(()=>theme.getPreferences());assert.equal(capped.readingLineScale,160);assert.equal(capped.readingBlockGap,24);assert.equal(capped.readingWidth,100);
    await p.evaluate(()=>{theme.destroy();startReadingTheme();theme.openSettings()});assert.equal(await p.getByRole('slider',{name:'正文行距',exact:true}).inputValue(),'160');
    await p.getByRole('button',{name:'高级',exact:true}).click();await p.getByRole('button',{name:'回退原版界面',exact:true}).click();await frames(p);assert.equal(await p.locator('.passage').evaluate(n=>n instanceof HTMLElement&&n.style.lineHeight),'');await p.getByRole('button',{name:'启用新版界面',exact:true}).click();await frames(p);assert.ok((await sample(p)).line>16*1.45);
    await p.getByRole('button',{name:'阅读',exact:true}).click();await p.getByRole('button',{name:'恢复原版排版',exact:true}).click();assert.ok(await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1));await p.screenshot({path:path.join(out,width+'-reading.png')});
    await p.evaluate(()=>{const original=Storage.prototype.setItem;Reflect.set(window,'restoreReadingStorage',()=>{Storage.prototype.setItem=original});Storage.prototype.setItem=()=>{throw Error('controlled storage failure')};theme.setPreference('readingBlockGap',8)});assert.equal(await p.evaluate(()=>theme.getPreferences().readingBlockGap),8);assert.match(await p.locator('.dmt-settings-footer').innerText(),/无法保存/);await p.evaluate(()=>{Reflect.get(window,'restoreReadingStorage')();theme.destroy()});
    rows.push({width,migrated,chosen,capped});
   }finally{await p.close()}
  }
  caseCheckpoint('reading-preferences-and-ui');fs.writeFileSync(path.join(out,'result.json'),JSON.stringify({status:'PASS',baseline,rows,environment:{node:process.version,chromium:browser.version(),platform:process.platform},scope:'Actual source settings plus controlled native typography/DOM. No real game, device or visual acceptance.'},null,2));console.log('PASS reading layout and settings; '+out);
 }finally{await server.close()}
}
if(require.main===module)(async()=>{const browser=await playwright.chromium.launch(require('./browser-options.cjs'));try{await verifyReading(browser,{baseline:process.argv.includes('--baseline')})}finally{await browser.close()}})().catch(e=>{console.error(e);process.exitCode=1});
export = {verifyReading};
