import playwright = require('playwright');
import esbuild = require('esbuild');
import assert = require('node:assert/strict');
import browserOptions = require('./browser-options.cjs');
import receipt = require('../scripts/ci-process-receipt.cjs');
const {chromium}=playwright,{buildSync}=esbuild;
declare const motion:ReturnType<typeof import('../src/ui/source-motion').sourceMotion>;
declare let calls:number,original:HTMLElement,arrivals:string[];
function requiredElement(selector:string){const node=document.querySelector(selector);if(!(node instanceof HTMLElement))throw Error('Missing fixture '+selector);return node}
declare const requireMotionElement:typeof requiredElement;
const bundle=buildSync({stdin:{contents:"import {sourceMotion} from './src/ui/source-motion';window.motion=sourceMotion()",resolveDir:process.cwd()},bundle:true,write:false,format:'iife'}).outputFiles[0]?.text;if(!bundle)throw Error('Missing motion bundle');
(async()=>{const b=await chromium.launch(browserOptions);try{const p=await b.newPage({viewport:{width:1100,height:800}});await p.setContent('<html data-dgu-visualMotion><body><button id="source">Original</button><div id="scroll" style="height:240px;overflow:auto"><div style="height:1600px"></div></div><div id="target" style="position:absolute;left:450px;top:100px;width:450px;height:500px"><button id="native">Native</button></div></body></html>');await p.addScriptTag({content:'window.requireMotionElement='+requiredElement.toString()});await p.addStyleTag({path:'src/theme/kraft-work-motion.css'});await p.addScriptTag({content:bundle});const first=await p.evaluate(()=>{Object.assign(window,{calls:0});requireMotionElement('#native').onclick=()=>calls++;Object.assign(window,{original:requireMotionElement('#native')});const from=requireMotionElement('#source').getBoundingClientRect(),to=requireMotionElement('#target').getBoundingClientRect();motion.relay(from,to);return{pointer:getComputedStyle(requireMotionElement('.kw-object-relay')).pointerEvents}});assert.equal(first.pointer,'none');await p.locator('#native').click();assert.equal(await p.evaluate(()=>calls),1);assert.equal(await p.evaluate(()=>original===document.querySelector('#native')),true);await p.evaluate(()=>{motion.cancel();const scroller=requireMotionElement('#scroll');Object.assign(window,{arrivals:[]});motion.scroll(scroller,1100,()=>arrivals.push('old'));motion.scroll(scroller,600,()=>arrivals.push('latest'))});await p.waitForTimeout(900);assert.deepEqual(await p.evaluate(()=>arrivals),['latest']);assert.ok(Math.abs(await p.locator('#scroll').evaluate(n=>n.scrollTop)-600)<2);
for(const mode of ['resize','off','reduced']){await p.evaluate(()=>{document.documentElement.setAttribute('data-dgu-visualMotion','');motion.relay(requireMotionElement('#source').getBoundingClientRect(),requireMotionElement('#target').getBoundingClientRect());const animation=requireMotionElement('.kw-object-relay').getAnimations()[0];if(!animation)throw Error('Relay animation missing');animation.pause();motion.scroll(requireMotionElement('#scroll'),1000,()=>arrivals.push('cancelled'))});if(mode==='resize')await p.evaluate(()=>window.dispatchEvent(new Event('resize')));if(mode==='off')await p.evaluate(()=>document.documentElement.removeAttribute('data-dgu-visualMotion'));if(mode==='reduced')await p.emulateMedia({reducedMotion:'reduce'});try{await p.waitForFunction(()=>document.querySelectorAll('.kw-object-relay').length===0,{},{timeout:1000})}catch(error){assert.equal(await p.locator('.kw-object-relay').count(),0,mode+' must remove paused relay');throw error};assert.equal(await p.locator('.kw-object-relay').count(),0,mode);assert.deepEqual(await p.evaluate(()=>arrivals),['latest'],mode);await p.emulateMedia({reducedMotion:'no-preference'});
// Let the emulated baseline reach rendering before the next preference change.
// Without this, Chromium can coalesce overrides: matches changes but no MQL event arrives.
await p.evaluate(()=>new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve))))}
await p.evaluate(()=>motion.dispose());assert.equal(await p.locator('.kw-object-relay').count(),0);console.log('PASS noninteractive material relay, original node/dispatch, latest real scroll arrival only, resize/motion/reduced/teardown cleanup');}finally{await b.close()}})().catch(e=>{receipt.terminalFailure(e);process.exitCode=1});
