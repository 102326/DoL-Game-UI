import playwright = require('playwright');
import esbuild = require('esbuild');
import assert = require('node:assert/strict');
const {chromium}=playwright,{buildSync}=esbuild;
declare const Core:typeof import('../framework/host');
declare const Shelf:typeof import('../framework/official-ui/reference-shelf');
(async()=>{const browser=await chromium.launch({channel:'msedge',headless:true});try{const page=await browser.newPage();await page.setContent('<div id="passages"></div><main id="views"></main>');for(const [entry,name]of [['framework/host.ts','Core'],['framework/official-ui/reference-shelf.ts','Shelf']] as const){const code=buildSync({entryPoints:[entry],bundle:true,format:'iife',globalName:name,write:false}).outputFiles[0]?.text;if(!code)throw Error('Missing reference bundle');await page.addScriptTag({content:code})}const result=await page.evaluate(async()=>{const host=Core.createHost(window),owner=host.register('Official'),shelf=Shelf.referenceShelf(host,owner),viewer=host.register('OtherLayout');shelf.remember({name:'Test coat',slot:'upper',colour:'blue',warmth:null,durability:null,lewd:null,outfit:'',detail:''});shelf.rememberProduct({title:'Test shirt',price:'£5',owned:'one'});const parent=document.querySelector('#views');if(!(parent instanceof HTMLElement))throw Error('Missing reference parent');for(const view of host.views()){const mounted=view.mount({id:view.id,parent,lifetime:'persistent'});if(!mounted)throw Error('Reference view refused mount');await mounted.ready;}const current=[...document.querySelectorAll('[role=status]')].every(n=>n.textContent.includes('来自本场景'));host.invalidateScene();host.sceneReady();const stale=[...document.querySelectorAll('[role=status]')].every(n=>n.textContent.includes('已离开来源场景'));const button=document.querySelector('#views button');if(!(button instanceof HTMLButtonElement))throw Error('Missing clear button');button.click();const independent=host.views().length===1&&host.views()[0]?.id==='shop-snapshot';shelf.dispose();viewer.dispose();owner.dispose();const cleaned=host.getDiagnostics().mounts.length===0&&host.views().length===0;host.dispose();return {current,stale,independent,cleaned}});assert.deepEqual(result,{current:true,stale:true,independent:true,cleaned:true});console.log('PASS persistent public reference views update stale origin across scenes, clear independently and release');}finally{await browser.close()}})().catch(e=>{console.error(e);process.exitCode=1});
