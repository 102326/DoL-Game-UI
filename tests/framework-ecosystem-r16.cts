function saveLoadOf(value:unknown):SaveLoad{const r=recordOf(value);return {money:numberOf(r.money),worn:stringOf(r.worn),hasExtension:booleanOf(r.hasExtension),stacked:stringsOf(r.stacked),oldState:booleanOf(r.oldState),oldDOM:booleanOf(r.oldDOM),oldBinding:r.oldBinding===null?null:booleanOf(r.oldBinding),currentBinding:r.currentBinding===null?null:booleanOf(r.currentBinding),name:stringOf(r.name)}}
