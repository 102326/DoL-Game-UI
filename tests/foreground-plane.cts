(async()=>{const {createServer}=await import('vite');const server=await createServer({configFile:false,logLevel:'error',plugins:[{name:'foreground-fixture',configureServer(s){s.middlewares.use('/__foreground__',(_q,r)=>{r.setHeader('Content-Type','text/html');r.end(`<!doctype html><html data-stone-free data-dol-midnight data-dgu-acrylic-adjustment><style>html{background:#596773;color:#eee}.hidden{display:none!important}#container{position:fixed;inset:0;z-index:999}#customOverlay{position:fixed;left:30px;top:45px;width:310px;height:450px;z-index:1000;box-sizing:border-box;border:1px solid #899;background:#181c2380;backdrop-filter:blur(24px)}#customOverlay>.evo-glass-layer,#weather{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}#customOverlayTitle{position:relative;z-index:2;padding:12px}button{min-height:44px;width:150px}:is(.dmt-orbit-focus,.sf-foreground-orbit){position:absolute;z-index:2;pointer-events:none}:is(.dmt-orbit-focus,.sf-foreground-orbit) svg{width:100%;height:100%;display:block}:is(.dmt-orbit-focus,.sf-foreground-orbit) rect{fill:none;stroke:#86aaa3;stroke-width:1;vector-effect:non-scaling-stroke}.dmt-orbit-flow{stroke-dasharray:16 84;animation:contour-clock 7s linear infinite}@keyframes contour-clock{to{stroke-dashoffset:-100}}.dmt-orbit-tail{stroke:#9c8fa9;stroke-dasharray:8 92}#customOverlayContent{height:120px;overflow:auto}.sf-foreground-paint :is(.dmt-orbit-focus,.sf-foreground-orbit) rect{fill:none}</style><div id="container"><div id="customOverlay" data-dgu-adapter="ModHubSoftWet" data-dgu-adapter-match="full"><div id="optics" class="evo-material-layer evo-glass-layer"></div><canvas id="weather" class="sf-weather-canvas"></canvas><header id="customOverlayTitle"><button id="native" onclick="this.dataset.calls=String(Number(this.dataset.calls||0)+1)">Native action</button>${[12,80].map(top=>`<div class="dmt-orbit-focus" data-sf-orbit-owner="1" aria-hidden="true" style="left:12px;top:${top}px;width:150px;height:44px;visibility:visible"><svg viewBox="0 0 150 44">${['base','flow','tail'].map(c=>`<rect class="dmt-orbit-${c}" x="1" y="1" width="148" height="42" rx="11" pathLength="100"/>`).join('')}</svg></div>`).join('')}<div class="dmt-orbit-focus" id="foreign">Unknown decoration</div></header><div id="customOverlayContent"><input id="value" value="kept"><p style="height:500px">Original content</p></div></div></div><script type="module">(${setup.toString()})()</script></html>`)})}}],server:{host:'127.0.0.1',port:0}});let browser:playwright.Browser|undefined;const checks:string[]=[];const output='tests/artifacts/ui41/foreground-plane-'+Date.now();fs.mkdirSync(output,{recursive:true});const errors:string[]=[];try{await server.listen();const address=server.httpServer?.address();assert.ok(address&&typeof address!=='string');browser=await playwright.chromium.launch(browserOptions);const page=await browser.newPage({viewport:{width:1280,height:900},deviceScaleFactor:2});page.on('pageerror',e=>errors.push(e.message));await page.goto(`http://127.0.0.1:${address.port}/__foreground__`);await page.waitForFunction(()=>typeof probe!=='undefined');const frame=()=>page.evaluate(()=>new Promise<void>(r=>requestAnimationFrame(()=>requestAnimationFrame(()=>r()))));
 const rootBefore=await page.locator('#customOverlay').evaluate(n=>({background:getComputedStyle(n).background,filter:getComputedStyle(n).backdropFilter}));await page.evaluate(()=>{const clock=document.querySelector('.dmt-orbit-flow')?.getAnimations()[0];if(!clock)throw Error('Missing original contour clock');Object.assign(window,{beforeForegroundClock:clock})});assert.equal(await page.evaluate(()=>probe.start()),true);await frame();assert.deepEqual(await page.evaluate(()=>probe.state()),{partsOriginal:false,nativeSame:true,planes:1,sources:2});assert.equal(await page.locator('.sf-foreground-paint #native').count(),0);assert.equal(await page.locator('.sf-foreground-paint #foreign').count(),0);await page.getByRole('button',{name:'Native action'}).click();assert.equal(await page.locator('#native').getAttribute('data-calls'),'1');assert.equal(await page.locator('#value').inputValue(),'kept');assert.deepEqual(await page.locator('#customOverlay').evaluate(n=>({background:getComputedStyle(n).background,filter:getComputedStyle(n).backdropFilter})),rootBefore);checks.push('one foreground, same native nodes/events/value and unchanged glass; unknown decoration excluded');
 const clockHandoff=await page.evaluate(async()=>{const flow=document.querySelector('.sf-foreground-orbit .dmt-orbit-flow'),clock=flow?.getAnimations()[0];if(!clock)throw Error('Missing visible contour clock');const start=Number(clock.currentTime);for(let i=0;i<20&&Number(clock.currentTime)<=start+32;i++)await new Promise<void>(r=>requestAnimationFrame(()=>r()));return{retired:beforeForegroundClock.playState,retiredTime:beforeForegroundClock.currentTime,advanced:Number(clock.currentTime)>start+32}});assert.deepEqual(clockHandoff,{retired:'idle',retiredTime:null,advanced:true});checks.push('handoff retires the nested clock while the visible contour continues advancing');
 for(const width of[1280,390])for(const zoom of[.8,1,1.25]){await page.setViewportSize({width,height:900});await page.evaluate(z=>{document.documentElement.style.zoom=String(z);document.querySelector<HTMLElement>('#customOverlayTitle')!.style.width='230px'},zoom);await frame();const geometry=await page.evaluate(()=>[...document.querySelectorAll<HTMLElement>('[data-sf-orbit-owner="1"]')].map((n,i)=>{const original=n.getBoundingClientRect(),clone=document.querySelectorAll('.sf-foreground-contour>.sf-foreground-orbit')[i]?.getBoundingClientRect();return{original:original.toJSON(),clone:clone?.toJSON(),dpr:devicePixelRatio}}));for(const g of geometry){assert.ok(g.clone);for(const k of['x','y','width','height'] as const)assert.ok(Math.abs(g.original[k]-g.clone[k])*g.dpr<=.5,JSON.stringify({width,zoom,k,g}))}}checks.push('1280/390, 80/100/125 percent zoom contours within half a device pixel');
 await page.evaluate(()=>{document.documentElement.style.zoom='1';const n=document.querySelector<HTMLElement>('[data-sf-orbit-owner="1"]')!;n.style.left='55px';n.style.width='170px';n.querySelector('svg')!.setAttribute('viewBox','0 0 170 44');n.querySelectorAll('rect').forEach(r=>r.setAttribute('width','168'))});await frame();assert.equal(await page.locator('.sf-foreground-contour svg').first().getAttribute('viewBox'),'0 0 170 44');checks.push('sole source geometry changes mirrored without replacing native content');
 assert.equal(await page.locator('.dmt-orbit-focus[data-sf-orbit-owner="1"]').count(),2,'clones do not masquerade as geometry owners');
 await page.evaluate(()=>{const root=document.querySelector<HTMLElement>('#customOverlay')!;root.animate([{opacity:0},{opacity:1}],{duration:180});root.classList.add('entering')});await frame();assert.equal((await page.evaluate(()=>probe.state())).partsOriginal,true,'entry keeps the grouped original fade');await page.waitForTimeout(220);await frame();assert.equal((await page.evaluate(()=>probe.state())).partsOriginal,false,'settled entry restores the foreground');
 await page.evaluate(()=>{const n=document.querySelector<HTMLElement>('[data-sf-orbit-owner="1"]')!;n.animate([{transform:'translateX(50px)'},{transform:'translateX(0)'}],{duration:350});n.style.top='15px'});await page.waitForTimeout(100);await frame();const moving=await page.evaluate(()=>{const source=document.querySelector<HTMLElement>('[data-sf-orbit-owner="1"]')!.getBoundingClientRect(),clone=document.querySelector('.sf-foreground-orbit')!.getBoundingClientRect();return{source:source.x,clone:clone.x,dpr:devicePixelRatio}});assert.ok(Math.abs(moving.source-moving.clone)*moving.dpr<=.5,JSON.stringify(moving));await page.waitForTimeout(300);checks.push('entry fade and live source animation keep their original timing and coordinates');
 await page.evaluate(()=>document.documentElement.removeAttribute('data-dgu-acrylic-adjustment'));await frame();assert.equal((await page.evaluate(()=>probe.state())).partsOriginal,true);await page.evaluate(()=>document.documentElement.setAttribute('data-dgu-acrylic-adjustment',''));await frame();assert.equal((await page.evaluate(()=>probe.state())).partsOriginal,false);checks.push('material master fallback restores the original nested surface');
 await page.evaluate(()=>document.querySelector('#customOverlay')!.classList.add('hidden'));await frame();assert.equal((await page.evaluate(()=>probe.state())).partsOriginal,true);assert.equal(await page.locator('[data-sf-foreground-source]').count(),0);await page.evaluate(()=>document.querySelector('#customOverlay')!.classList.remove('hidden'));await frame();assert.equal((await page.evaluate(()=>probe.state())).partsOriginal,false);await page.evaluate(()=>probe.stop());assert.deepEqual(await page.evaluate(()=>probe.state()),{partsOriginal:true,nativeSame:true,planes:0,sources:0});checks.push('hide/reopen and normal disposal restore original parts and contours');
 await page.evaluate(()=>document.querySelector('#customOverlay')!.setAttribute('data-dgu-adapter-match','partial'));assert.equal(await page.evaluate(()=>probe.start()),false);assert.equal((await page.evaluate(()=>probe.state())).partsOriginal,true);await page.evaluate(()=>document.querySelector('#customOverlay')!.setAttribute('data-dgu-adapter-match','full'));assert.equal(await page.evaluate(()=>probe.fault()),true);assert.equal((await page.evaluate(()=>probe.state())).planes,0);assert.equal((await page.evaluate(()=>probe.state())).partsOriginal,true);checks.push('partial structure and construction fault retain nested presentation');
 await page.evaluate(()=>probe.start());await frame();assert.equal(await page.evaluate(()=>probe.throwingStop()),true);assert.deepEqual(await page.evaluate(()=>probe.state()),{partsOriginal:true,nativeSame:true,planes:0,sources:0});checks.push('throwing cleanup releases both mirrors, parts and host');assert.deepEqual(errors,[]);console.log('PASS foreground plane: '+checks.join('; '));
 }finally{fs.writeFileSync(output+'/result.json',JSON.stringify({checks,errors},null,2));await browser?.close();await server.close()}})().catch(error=>{receipt.terminalFailure(error);process.exitCode=1});
