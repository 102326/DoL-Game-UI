import playwright = require('playwright');
import assert = require('node:assert/strict');
const {chromium}=playwright;
function installProbe(){const probe={nodes:[...document.querySelectorAll('#ui-bar *')],clicks:0},foreign=document.getElementById('foreign');if(!foreign)throw Error('Missing foreign button');foreign.onclick=()=>probe.clicks++;Object.assign(window,{sidebarSurfaceProbe:probe});return probe}
declare const sidebarSurfaceProbe:ReturnType<typeof installProbe>;
(async()=>{const b=await chromium.launch({channel:'msedge',headless:true});try{const p=await b.newPage();await p.setContent(`<html data-dol-midnight data-dmt-layout><style>#ui-bar{width:280px}.meter{height:7px;background:#777}.meter>div{height:100%;background:green}button{min-height:44px}#foreign{background:rgb(120,40,80)}</style><div id="ui-bar"><div id="stats">Time / Money</div><div id="statmeters"><div id="paincaption">Pain<div class="meter"><div style="width:50%"></div></div></div><div id="oxygencaption" hidden>Oxygen<div class="meter"></div></div><div id="gracecaption">Grace<div class="meter"><div style="width:25%"></div></div></div><div id="modcaption">Mod value</div></div><div id="overlayButtons"><button class="link-internal">Attributes</button><div class="sidebarButtonSplit"><button class="link-internal">Saves</button></div><button id="foreign">Mod action</button><button id="dmc-sidebar-button">Center</button><button id="dol-midnight-sidebar-button">Settings</button></div></div>`);await p.evaluate(installProbe);const original=await p.evaluate(()=>document.getElementById('ui-bar')?.outerHTML);await p.addStyleTag({path:'src/theme/sidebar.css'});for(const width of [390,1363]){await p.setViewportSize({width,height:500});assert.equal(await p.locator('#ui-bar').evaluate(e=>e.scrollWidth<=e.clientWidth),true);assert.equal(await p.locator('#oxygencaption').isVisible(),false)}assert.equal(await p.locator('#foreign').evaluate(e=>getComputedStyle(e).backgroundColor),'rgb(120, 40, 80)');await p.locator('#foreign').click();assert.equal(await p.evaluate(()=>sidebarSurfaceProbe.clicks),1);assert.equal(await p.evaluate(()=>document.getElementById('ui-bar')?.outerHTML),original);assert.equal(await p.evaluate(()=>sidebarSurfaceProbe.nodes.every(e=>e.isConnected)),true);assert.equal(await p.locator('#paincaption .meter').evaluate(e=>getComputedStyle(e).height),'3px');await p.evaluate(()=>document.documentElement.removeAttribute('data-dmt-layout'));assert.equal(await p.locator('#paincaption .meter').evaluate(e=>getComputedStyle(e).height),'7px');console.log('PASS sidebar native nodes/actions, hidden meters, unknown Mod styling, narrow/wide and layout-off fallback')}finally{await b.close()}})().catch(e=>{console.error(e);process.exitCode=1});
