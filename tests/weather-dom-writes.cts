 const draw=(time?:number,wet?:number)=>{if(time!==undefined)frame.time=time;if(wet!==undefined)frame.wet=wet;renderer.draw(frame)};
 Object.assign(window,{rainDOM:{draw,snapshot:renderer.snapshot,dispose:renderer.dispose}});for(let i=0;i<10;i++)draw();
