const baseline=process.argv.includes('--baseline'),file='src/ui/weather/wet-glass.ts',revision='178f8b2b5b1828038b7c3ec304e8995bbe99ee38',old=baseline?cp.execFileSync('git',['show',revision+':'+file],{encoding:'utf8'}):undefined;
async function check(name:string,run:()=>Promise<void>){await cases.runCase(name,run);console.log('PASS',name)}
(async()=>{const {createServer}=await import('vite');const server=await createServer({configFile:false,plugins:[{name:'weather-dom-write-contract',enforce:'pre',load(id){if(old&&id.replaceAll('\\','/').endsWith('/'+file))return old},configureServer(s){s.middlewares.use('/__weather_dom__',(_q,r)=>{r.setHeader('Content-Type','text/html');r.end(`<!doctype html><style>.dmt-settings-shell{position:relative;width:960px;height:700px;overflow:hidden}canvas{position:absolute;inset:0;width:960px;height:700px}.dmt-workspace{position:absolute;left:220px;top:180px;width:300px;height:200px}</style><div class="dmt-settings-shell"><canvas width="960" height="700"></canvas><div class="dmt-workspace"><button>Original control</button><p>Protected reading content.</p></div></div><script type="module">(${setup.toString()})()</script>`)})}}],server:{host:'127.0.0.1',port:0}});let browser:playwright.Browser|undefined;const result:Record<string,unknown>={baseline,baselineRef:revision,inputSha256:crypto.createHash('sha256').update(old??fs.readFileSync(file)).digest('hex')};try{await server.listen();const address=server.httpServer?.address();assert.ok(address&&typeof address!=='string');browser=await playwright.chromium.launch(require('./browser-options.cjs'));const p=await browser.newPage({viewport:{width:1280,height:900}});const errors:string[]=[];p.on('pageerror',e=>errors.push(e.message));await p.goto(`http://127.0.0.1:${address.port}/__weather_dom__`);await p.waitForFunction(()=>typeof rainDOM!=='undefined');
 await check('stationary glass frame does not rewrite DOM',async()=>{const r=await p.evaluate(async()=>{const layer=document.querySelector('.evo-glass-layer');if(!layer)throw Error('Missing layer');const before=rainDOM.snapshot(),nodes=[...layer.querySelectorAll('.evo-glass-drop,.evo-wet-path')],o=new MutationObserver(()=>{});o.observe(layer,{subtree:true,attributes:true,childList:true});for(let i=0;i<12;i++)rainDOM.draw();const mutations=o.takeRecords().length;o.disconnect();return{mutations,active:before.activeDrops,nodesSame:nodes.every((n,i)=>layer.querySelectorAll('.evo-glass-drop,.evo-wet-path')[i]===n),snapshotSame:JSON.stringify(before)===JSON.stringify(rainDOM.snapshot())}});result.stationary=r;assert.ok(r.active>0);assert.equal(r.nodesSame,true);assert.equal(r.snapshotSame,true);assert.equal(r.mutations,0,'unchanged material frame must not rewrite inline styles or data flags')});
 await check('moving glass retains geometry and original controls',async()=>{const r=await p.evaluate(()=>{const root=document.querySelector('.dmt-settings-shell'),layer=document.querySelector('.evo-glass-layer'),button=document.querySelector('button');if(!root||!layer||!button)throw Error('Missing fixture');const before=rainDOM.snapshot(),nodes=[...layer.children],o=new MutationObserver(()=>{});o.observe(layer,{subtree:true,attributes:true,childList:true});for(let i=1;i<=60;i++)rainDOM.draw(2+i/60);const records=o.takeRecords();o.disconnect();const after=rainDOM.snapshot(),visible=[...layer.querySelectorAll<HTMLElement>('.evo-glass-drop')].filter(n=>n.style.display==='block'),base=root.getBoundingClientRect();const geometry=visible.map(n=>{const d=after.drops.find(d=>String(d.id)===n.dataset.dropId);if(!d)throw Error('Missing real drop');const r=n.getBoundingClientRect(),css=getComputedStyle(n),stretch=Math.sqrt(1+Math.min(.55,d.vy*.012)),rx=Math.sqrt(d.area)/stretch,ry=Math.sqrt(d.area)*stretch;return{dx:Math.abs(r.left-base.left-(d.x-rx)),dy:Math.abs(r.top-base.top-(d.y-ry)),dw:Math.abs(r.width-Math.max(rx*2,parseFloat(css.borderLeftWidth)+parseFloat(css.borderRightWidth))),dh:Math.abs(r.height-Math.max(ry*2,parseFloat(css.borderTopWidth)+parseFloat(css.borderBottomWidth))),filter:css.backdropFilter}});return{writes:records.length,remounts:records.filter(r=>r.type==='childList').length,nodesSame:nodes.every((n,i)=>layer.children[i]===n),advanced:JSON.stringify(before.drops)!==JSON.stringify(after.drops),geometry:geometry.every(g=>g.dx<.05&&g.dy<.05&&g.dw<.05&&g.dh<.05&&g.filter.includes('url(')),geometryFailures:geometry.filter(g=>g.dx>=.05||g.dy>=.05||g.dw>=.05||g.dh>=.05||!g.filter.includes('url(')).slice(0,4),visible:visible.length,controlSame:document.querySelector('button')===button,overlap:after.protectedOverlap}});result.moving=r;assert.ok(r.writes>0&&r.advanced&&r.visible>0);assert.equal(r.remounts,0);assert.equal(r.nodesSame,true);assert.equal(r.geometry,true);assert.equal(r.controlSame,true);assert.equal(r.overlap,0)});
 await check('same-frame repaint restores changed owned style',async()=>{const r=await p.evaluate(()=>{const n=document.querySelector<HTMLElement>('.evo-glass-drop[data-drop-id]');if(!n)throw Error('Missing visible drop');const expected=n.style.opacity;n.style.opacity='0';rainDOM.draw();return{expected,after:n.style.opacity}});assert.equal(r.after,r.expected);assert.notEqual(r.expected,'0')});
 await check('dry repeated frame is quiet and material releases',async()=>{const r=await p.evaluate(()=>{rainDOM.draw(3,0);const layer=document.querySelector('.evo-glass-layer');if(!layer)throw Error('Missing layer');const o=new MutationObserver(()=>{});o.observe(layer,{attributes:true,childList:true,subtree:true});for(let i=0;i<8;i++)rainDOM.draw();const writes=o.takeRecords().length;o.disconnect();rainDOM.dispose();rainDOM.dispose();return{writes,left:document.querySelectorAll('.evo-glass-layer').length}});result.dry=r;assert.equal(r.writes,0);assert.equal(r.left,0)});assert.deepEqual(errors,[]);result.status='PASS';
}finally{fs.mkdirSync('tests/artifacts',{recursive:true});fs.writeFileSync(path.resolve('tests/artifacts/weather-dom-writes-'+(baseline?'baseline':'current')+'.json'),JSON.stringify(result,null,2));await browser?.close();await server.close()}})().catch(e=>{receipt.terminalFailure(e);process.exitCode=1});
