import playwright = require('playwright');
import assert = require('node:assert/strict');
import path = require('node:path');
import url = require('node:url');
import browserOptions = require('./browser-options.cjs');
import type {GameUiControls} from '../src/runtime/game-controls';
declare const DoLGameUI:GameUiControls;
declare let underCalls:number;
declare const oldSettings:Element;
const {chromium}=playwright,{pathToFileURL}=url;
function requiredElement(selector:string):HTMLElement{const n=document.querySelector(selector);if(!(n instanceof HTMLElement))throw Error('Missing HTML element '+selector);return n}
function bounds(n:Element){const r=n.getBoundingClientRect();return {x:r.x,y:r.y,width:r.width,height:r.height,top:r.top,left:r.left,right:r.right,bottom:r.bottom}}
(async()=>{const b=await chromium.launch(browserOptions);try{const p=await b.newPage({viewport:{width:1363,height:620}}),errors:string[]=[];p.on('pageerror',e=>errors.push(e.message));await p.goto(pathToFileURL(path.join(process.cwd(),'tests/fixture.html')).href);await p.waitForSelector('#listContainer');await p.addStyleTag({path:'dist/framework/official-ui/style.css'});for(const n of ['host','official-ui'])await p.addScriptTag({path:`dist/framework/${n}/index.js`});await p.addScriptTag({content:requiredElement.toString()+';'+bounds.toString()});await p.waitForFunction(()=>typeof DoLGameUI!=='undefined'&&!!DoLGameUI);await p.evaluate(()=>{document.body.style.minHeight='2500px';Object.assign(window,{underCalls:0});const n=document.createElement('button');n.id='settings-underlay';n.style.cssText='position:fixed;left:400px;top:300px;z-index:50';n.textContent='underlay';n.onclick=()=>underCalls++;document.body.append(n);scrollTo(0,200);DoLGameUI.openSettings()});await p.waitForTimeout(650);
 for(const name of ['左右','上下']){await p.getByRole('button',{name,exact:true}).click();await p.waitForTimeout(700);const geometry=await p.evaluate(()=>{const d=requiredElement('#dol-midnight-controls'),s=requiredElement('.dmt-settings-shell');return{modal:d.matches(':modal'),mask:bounds(d),shell:bounds(s),rootBG:getComputedStyle(d).backgroundColor,rootBlur:getComputedStyle(d).backdropFilter,bodyY:scrollY}});assert.equal(geometry.modal,true);assert.equal(geometry.mask.width,1363);assert.equal(geometry.mask.height,620);assert.equal(geometry.rootBG,'rgba(0, 0, 0, 0)');assert.equal(geometry.rootBlur,'none');assert.ok(geometry.shell.width<geometry.mask.width);const w=p.locator('.dmt-workspace');await w.evaluate(n=>n.scrollTop=0);const box=await w.boundingBox();assert.ok(box);await p.mouse.move(box.x+box.width*.7,box.y+box.height*.6);await p.mouse.wheel(0,900);await p.waitForTimeout(450);assert.ok(await w.evaluate(n=>n.scrollTop>0),'long settings body scrolls');assert.equal(await p.evaluate(()=>scrollY),geometry.bodyY,'underlying page stays still');await w.evaluate(n=>n.scrollTop=0);await p.locator('input[aria-label="手机紧凑按钮间距"]').click();assert.equal(await p.evaluate(()=>underCalls),0)}
 const surface=await p.locator('.dmt-settings-shell').evaluate(n=>({background:getComputedStyle(n).backgroundColor,blur:getComputedStyle(n).backdropFilter}));assert.ok(Number(surface.background.match(/[\d.]+/g)?.[3]??1)>=.8);assert.equal(surface.blur,'none');assert.equal(await p.locator('.dmt-settings-context,.dmt-settings-material,.dmt-open-material').count(),0);for(const size of [{width:390,height:844},{width:844,height:390},{width:1363,height:620}]){await p.setViewportSize(size);await p.waitForFunction(()=>{const r=requiredElement('.dmt-settings-shell').getBoundingClientRect();return r.width>0&&r.height>0&&r.x>=0&&r.y>=0&&r.right<=innerWidth+1&&r.bottom<=innerHeight+1})}await p.locator('.dmt-close').click();await p.waitForTimeout(400);assert.equal(await p.evaluate(()=>document.documentElement.hasAttribute('data-dgu-settings-open')),false);assert.equal(await p.locator('.dmt-settings-context,.dmt-settings-material').count(),0);await p.locator('#settings-underlay').click();assert.equal(await p.evaluate(()=>underCalls),1);await p.evaluate(()=>DoLGameUI.openSettings());await p.waitForTimeout(650);await p.mouse.click(5,300);await p.waitForTimeout(400);assert.equal(await p.locator('#dol-midnight-controls').evaluate(n=>n instanceof HTMLDialogElement&&n.open),false);assert.equal(await p.evaluate(()=>underCalls),1,'outside mask cannot click underlying control');await p.evaluate(()=>DoLGameUI.openSettings());await p.waitForTimeout(600);await p.evaluate(()=>{Object.assign(window,{oldSettings:requiredElement('#dol-midnight-controls')});oldSettings.remove()});await p.waitForFunction(()=>{const next=document.querySelector('#dol-midnight-controls');return !!next&&next!==oldSettings});assert.equal(await p.locator('.dmt-settings-context,.dmt-settings-material').count(),0);assert.equal(await p.evaluate(()=>document.documentElement.hasAttribute('data-dgu-settings-open')),false);await p.evaluate(()=>DoLGameUI.openSettings());await p.waitForTimeout(650);await p.evaluate(()=>DoLGameUI.destroy());assert.equal(await p.locator('.dmt-settings-context,.dmt-settings-material').count(),0);assert.equal(await p.evaluate(()=>document.documentElement.hasAttribute('data-dgu-settings-open')),false);assert.deepEqual(errors,[]);const fallback=await b.newPage({viewport:{width:900,height:700}});await fallback.goto(pathToFileURL(path.join(process.cwd(),'tests/fixture.html')).href);await fallback.waitForSelector('#listContainer');await fallback.addScriptTag({content:requiredElement.toString()+';'+bounds.toString()});await fallback.evaluate(()=>Object.defineProperty(HTMLDialogElement.prototype,'showModal',{value:undefined,configurable:true}));await fallback.addStyleTag({path:'dist/framework/official-ui/style.css'});for(const n of ['host','official-ui'])await fallback.addScriptTag({path:`dist/framework/${n}/index.js`});await fallback.evaluate(()=>DoLGameUI.openSettings());await fallback.waitForTimeout(650);assert.equal(await fallback.locator('#dol-midnight-controls').evaluate(n=>n.classList.contains('dmt-modeless')),true);assert.equal(await fallback.locator('.dmt-settings-context,.dmt-settings-material').count(),0);assert.equal(await fallback.locator('.dmt-close').evaluate(n=>{const r=n.getBoundingClientRect();return n.contains(document.elementFromPoint(r.x+r.width/2,r.y+r.height/2))}),true);await fallback.getByLabel('手机紧凑按钮间距',{exact:true}).click();assert.equal(await fallback.evaluate(()=>DoLGameUI.getPreferences().mobileCompactControls),true);await fallback.locator('.dmt-close').click();await fallback.waitForTimeout(400);assert.equal(await fallback.locator('.dmt-settings-material,.dmt-settings-context').count(),0);await fallback.close();console.log('PASS full viewport input mask, transparent outer shell, scrollable settings in both layouts, background scroll/click blocked and restored');}finally{await b.close()}})().catch(e=>{console.error(e);process.exitCode=1});
