import playwright = require('playwright');
import assert = require('node:assert/strict');
import path = require('node:path');
import url = require('node:url');
import type {GameUiControls} from '../src/runtime/game-controls';
import type {FloatingApi} from '../src/floating/preferences';
const {chromium}=playwright,{pathToFileURL}=url;
declare const DoLGameUI:GameUiControls,DoLFloatingTools:FloatingApi;
declare const SugarCube:{State:{variables:Record<string,unknown>};Engine:{play(passage:string):void}};
declare const native:Element,nativeParent:Node|null,variables:string;
(async()=>{const b=await chromium.launch({channel:'msedge',headless:true});try{
 const p=await b.newPage({viewport:{width:900,height:700}}),errors:string[]=[];p.on('pageerror',e=>errors.push(e.message));
 await p.goto(pathToFileURL(path.join(__dirname,'fixture.html')).href);await p.waitForSelector('#listContainer');
 const theme='DoLMidnightTheme.preferences.v1',floating='DoLGameUI.stoneFree.floating.v1';
 const inject=()=>p.addScriptTag({path:path.join(__dirname,'../dist/game-ui.js')});
 const settle=()=>p.evaluate(()=>new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(r))));
 await p.addStyleTag({path:path.join(__dirname,'../dist/game-ui.css')});await p.evaluate(()=>localStorage.clear());await inject();
 assert.equal(await p.evaluate(()=>DoLFloatingTools.getPreferences().enabled),false);assert.equal(await p.locator('#dol-stone-free-floating,#dol-story-actions').count(),0);
 await p.evaluate(()=>{const node=document.querySelector('#custom-native');if(!node)throw Error('Missing native fixture element');Object.assign(window,{native:node,nativeParent:node.parentNode,variables:JSON.stringify(SugarCube.State.variables)})});
 await p.evaluate(({theme,floating})=>{DoLGameUI.destroy();localStorage.setItem(theme,JSON.stringify({_scaleBaseline26:true,fontScale:125,buttonScale:75,comfortable:false,visualTier:2,savesV2:true,statusPreview:true,startupCacheLazy:true,storyActions:true}));localStorage.setItem(floating,JSON.stringify({enabled:true,hidden:false,mode:'grid',x:.31,y:.72,tools:['move']}))},{theme,floating});await inject();await settle();
 let saved=await p.evaluate(()=>DoLGameUI.getPreferences());assert.equal(saved.fontScale,125);assert.equal(saved.buttonScale,75);assert.equal(saved.comfortable,false);assert.equal(saved.savesV2,true);
 for(const key of ['storyActions','statusPreview','startupCacheLazy'])assert.equal(saved[key],false);
 assert.equal(await p.evaluate(()=>typeof Reflect.get(window,'DoLStoryActionsUI')),'undefined');assert.equal(await p.locator('#dol-story-actions').count(),0);
 await p.evaluate(()=>DoLGameUI.setPreference('storyActions',true));assert.equal(await p.evaluate(()=>DoLGameUI.getPreferences().storyActions),false);
 await p.evaluate(()=>DoLGameUI.openSettings());assert.equal(await p.getByText('原版常用动作底栏（实验）',{exact:true}).count(),0);
 const beforeReset=await p.evaluate(()=>({theme:DoLGameUI.getPreferences(),floating:DoLFloatingTools.getPreferences()}));
 await p.getByRole('button',{name:'恢复 100%',exact:true}).click();const afterReset=await p.evaluate(()=>({theme:DoLGameUI.getPreferences(),floating:DoLFloatingTools.getPreferences()}));
 assert.deepEqual(afterReset,{theme:{...beforeReset.theme,fontScale:100,buttonScale:100},floating:beforeReset.floating},'scale reset is scoped');
 await p.locator('.dsf-settings-more>summary').click();await p.getByRole('button',{name:'重置悬浮球位置',exact:true}).click();
 const positionReset=await p.evaluate(()=>DoLFloatingTools.getPreferences());assert.deepEqual(positionReset,{...beforeReset.floating,x:.88,y:.45});
 await p.evaluate(()=>{DoLFloatingTools.setPreference('x',.31);DoLFloatingTools.setPreference('y',.72);DoLGameUI.setPreference('fontScale',125);DoLGameUI.setPreference('buttonScale',75)});
 await p.locator('.dmt-close').click();await settle();assert.equal(await p.locator('#dol-stone-free-floating').count(),1);
 const intended=await p.evaluate(()=>({theme:DoLGameUI.getPreferences(),floating:DoLFloatingTools.getPreferences()}));
 await p.evaluate(()=>DoLGameUI.setPreference('enabled',false));await settle();assert.equal(await p.locator('#dol-stone-free-floating,.dcu-root').count(),0);
 await p.evaluate(()=>DoLGameUI.setPreference('enabled',true));await settle();assert.deepEqual(await p.evaluate(()=>({theme:DoLGameUI.getPreferences(),floating:DoLFloatingTools.getPreferences()})),intended);
 for(let i=0;i<2;i++){await p.evaluate(()=>DoLGameUI.destroy());await inject();await settle();assert.deepEqual(await p.evaluate(()=>({theme:DoLGameUI.getPreferences(),floating:DoLFloatingTools.getPreferences()})),intended,'repeat startup preserves migrated choices')}
 await p.evaluate(()=>DoLFloatingTools.setPreference('enabled',false));await settle();await p.evaluate(()=>SugarCube.Engine.play('Outside'));await settle();assert.equal(await p.locator('#dol-stone-free-floating,.dsf-menu').count(),0);
 assert.equal(await p.evaluate(()=>native.parentNode===nativeParent&&JSON.stringify(SugarCube.State.variables)===variables),true,'UI changes preserve native state and ownership');
 await p.evaluate(()=>DoLGameUI.destroy());assert.deepEqual(errors,[]);
 console.log('PASS 2.7 settings: fresh defaults, old choices, retired action experiment, scoped resets, master recovery, repeat migration and disabled tools across passage changes');
 }finally{await b.close()}})().catch(e=>{console.error(e);process.exitCode=1});
