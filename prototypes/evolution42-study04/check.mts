import {createEvo42Server} from '../../scripts/preview-evo42.mts';
import {chromium} from 'playwright';import assert from 'node:assert/strict';import fs from 'node:fs';
const out='tests/artifacts/ui42/study04';fs.mkdirSync(out,{recursive:true});const s=await createEvo42Server(0);const addr=s.httpServer!.address();assert(addr&&typeof addr!=='string');const browser=await chromium.launch({headless:true});const errors:string[]=[];
try{for(const width of [1280,390])for(const mode of ['baseline','study']){
 const context=await browser.newContext({viewport:{width,height:900},recordVideo:{dir:out,size:{width,height:900}}}),page=await context.newPage();page.on('pageerror',e=>errors.push(e.message));
 await page.goto(`http://127.0.0.1:${addr.port}/prototypes/evolution42-study04/index.html?mode=${mode}`);await page.locator('#dol-midnight-controls[open] .dmt-settings-shell').waitFor();await page.waitForTimeout(500);
 const dialog=page.locator('#dol-midnight-controls'),shell=dialog.locator('.dmt-settings-shell');assert.equal(await shell.getAttribute('data-study04')!==null,mode==='study');
 await page.screenshot({path:`${out}/${mode}-${width}.png`});
 await dialog.getByRole('button',{name:'材质',exact:true}).click();await dialog.getByRole('heading',{name:'看见层次如何变化'}).waitFor();const toggle=dialog.getByRole('checkbox',{name:'玻璃模糊',exact:true});await toggle.uncheck();assert.equal(await shell.evaluate(e=>getComputedStyle(e).backdropFilter),'none');await toggle.check();const acrylic=dialog.getByLabel('Acrylic 通透度',{exact:true});await acrylic.fill('0');const dark=await shell.evaluate(e=>getComputedStyle(e).backgroundImage+' / '+getComputedStyle(e).backgroundColor);await acrylic.fill('60');const normal=await shell.evaluate(e=>getComputedStyle(e).backgroundImage+' / '+getComputedStyle(e).backgroundColor);assert.notEqual(dark,normal,'transparency control must affect the shell');await dialog.getByRole('button',{name:'阅读',exact:true}).click();
 const select=dialog.getByLabel('选项文字对齐',{exact:true});await select.selectOption('center');assert.equal(await select.inputValue(),'center');await select.selectOption('left');
 const h=dialog.locator('.dmt-settings-header'),r=await h.boundingBox();assert(r);await page.mouse.move(r.x+r.width*.35,r.y+r.height*.5);await page.mouse.down();await page.mouse.move(r.x+r.width*.35+25,r.y+r.height*.5+8,{steps:6});await page.waitForTimeout(35);
 const held=await page.evaluate(()=>Reflect.get(window,'study04').snapshot().motion);assert.equal(held.dragging,true);if(mode==='study')assert.ok(held.frames>0 && Math.abs(held.fx)+Math.abs(held.fy)>0,JSON.stringify(held));
 await page.mouse.up();await page.waitForTimeout(100);const r2=await h.boundingBox();assert(r2);await page.mouse.move(r2.x+r2.width*.35,r2.y+r2.height*.5);await page.mouse.down();assert.equal(await page.evaluate(()=>Reflect.get(window,'study04').snapshot().motion.dragging),true);await page.mouse.up();await page.waitForTimeout(500);
 await page.evaluate(()=>((document.activeElement as HTMLElement)?.blur()));await page.keyboard.press(mode==='baseline'?'Alt+1':'Alt+0');assert.equal(await shell.getAttribute('data-study04')!==null,mode==='baseline');await dialog.locator('.dmt-close').click();await dialog.waitFor({state:'hidden'});await page.locator('#open').click();await dialog.waitFor({state:'visible'});await page.waitForTimeout(300);const video=page.video();await context.close();assert(video);fs.copyFileSync(await video.path(),`${out}/${mode}-${width}.webm`);console.log(width,mode,'PASS');
}
const reduced=await browser.newContext({viewport:{width:1280,height:900},reducedMotion:'reduce'}),page=await reduced.newPage();page.on('pageerror',e=>errors.push(e.message));await page.goto(`http://127.0.0.1:${addr.port}/prototypes/evolution42-study04/index.html?mode=study`);const h=page.locator('#dol-midnight-controls .dmt-settings-header');await h.waitFor();const r=await h.boundingBox();assert(r);await page.mouse.move(r.x+150,r.y+40);await page.mouse.down();await page.mouse.move(r.x+220,r.y+50,{steps:5});await page.waitForTimeout(60);const state=await page.evaluate(()=>Reflect.get(window,'study04').snapshot().motion);assert.equal(state.fx,0);assert.equal(state.fy,0);assert.equal(state.cx,0);assert.equal(state.cy,0);assert.equal(await page.locator('.dmt-settings-shell').evaluate(e=>(e as HTMLElement).style.scale),'1');await page.mouse.up();
await page.evaluate(()=>{const api=Reflect.get(window,'study04');api.open();api.dispose();api.open();api.select('baseline')});await page.waitForTimeout(100);assert.equal(await page.evaluate(()=>Reflect.get(window,'study04').snapshot().active),false);assert.equal(await page.locator('#dol-midnight-controls').count(),0);await reduced.close();console.log('reduced-motion and disposal PASS');assert.deepEqual(errors,[])}finally{await browser.close();await s.close()}
